import os
import sys
import SCons

from SConsCommon import *
from SConsExternCommon import *

Import('parent_env parent_targets parent_report')

envLibrary = parent_env.Clone()

# switch
buildStaticLinking = True

# parameters
libVersion = '1.5.4'
srcdir = 'dav1d-{}'.format(libVersion)

libLinkName = 'dav1d'

if envLibrary['OSWindows']:
	libFileName = 'bin/lib{}.dll'.format(libLinkName)
	staticFileName = 'lib/lib{}.a'.format(libLinkName)
else:
	libFileName = envLibrary.subst('lib/${{SHLIBPREFIX}}{}{}'.format(libLinkName, envLibrary['SHLIBSUFFIX']))
	staticFileName = envLibrary.subst('lib/${{LIBPREFIX}}{}{}'.format(libLinkName, envLibrary['LIBSUFFIX']))

# fetching is always allowed
nodeArtifacts = envLibrary.DownloadArtifactHelper('{}.tar.xz'.format(srcdir), 'libdav1d', 'lib_libdav1d_fetch')

# patches
patches = []
globFiles(envLibrary, 'patches/{}'.format(libVersion), '*.patch', patches, recursive=False)
envLibrary.Append(PATCHES = [envLibrary.File(x) for x in sorted(patches)])

# check if system libdav1d is present
hasSystemDav1d = False
conf = envLibrary.Configure()
if envLibrary['with_system_libdav1d'] != TernaryVariableNo:
	hasSystemDav1d = conf.CheckLibWithHeader(libLinkName, 'dav1d/dav1d.h', 'c++', call='dav1d_version();')
conf.Finish()

if not hasSystemDav1d and envLibrary['with_system_libdav1d'] == TernaryVariableYes:
	Exit('Requested to use system libdav1d but no usable libdav1d found.')

libs = [libLinkName]

parent_report['use system libdav1d'] = 'yes' if hasSystemDav1d else 'no'

if hasSystemDav1d:
	parent_targets['lib_libdav1d'] = {
		'name' : 'Internal libdav1d library',
		'cpppath' : [],
		'libpath' : [],
		'libs' : libs,
		'runtimelibs' : [],
		'depends' : [] }
	Return()

# build libdav1d
def libdav1dBuild(target, source, env):
	buildDir = target[0].get_dir().up()
	
	untarArchive(buildDir.abspath, source[0].abspath)
	
	# create vcs_version.h otherwise meson tries to use git on a non-existing git repository
	srcPath = buildDir.Dir(srcdir).abspath
	vcsVersionFile = os.path.join(srcPath, 'include', 'vcs_version.h')
	os.makedirs(os.path.dirname(vcsVersionFile), exist_ok=True)
	with open(vcsVersionFile, 'w') as f:
		f.write('/* auto-generated, do not edit */\n')
		f.write('#define DAV1D_VERSION "{}"\n'.format(libVersion))
	
	script = createScriptHeader(env)
	
	script.append('cd "{}" || exit 1'.format(srcPath))
	
	# apply patches
	for p in env['PATCHES']:
		script.append('patch -p1 <{} || exit 1'.format(p.srcnode().abspath))
	
	# if '--reconfigure' is used on meson setup it fails if there exists no configuration yet.
	# totally stupid check breaking automated build systems. as a workaround the directory is
	# always deleted so the '--reconfigure' is not required to be used
	script.append('rm -rf build_dir')
	
	script.append('mkdir -p build_dir || exit 1')
	script.append('cd build_dir || exit 1')
	
	cmdline = ['meson', 'setup', '--prefix="{}"'.format(buildDir.abspath), '..']
	cmdline.append('--buildtype=release')
	cmdline.append('-Denable_tests=false')
	cmdline.append('-Denable_docs=false')
	cmdline.append('-Denable_tools=false')
	if buildStaticLinking:
		cmdline.append('-Ddefault_library=static')
	else:
		cmdline.append('-Ddefault_library=shared')
	
	if 'CROSS_FILE' in env:
		cmdline.append('--cross-file "{}"'.format(env['CROSS_FILE'].abspath))
	
	script.append('{} || exit 1'.format(' '.join(cmdline)))
	
	script.append('ninja -j {} install || exit 1'.format(env['with_threads']))
	
	# handle Meson installing library to unpredictable path. find libdav1d.a anywhere
	# under install_dir and copy to lib if needed
	script.append('install_dir="{}"'.format(buildDir.abspath))
	script.append('target_lib="$install_dir/lib/libdav1d.a"')
	script.append('if [ ! -f "$target_lib" ]; then')
	script.append('  mkdir -p "$install_dir/lib"')
	script.append('  source_lib=$(find "$install_dir" -name "libdav1d.a" -type f 2>/dev/null | head -1)')
	script.append('  if [ -n "$source_lib" ]; then')
	script.append('    cp -fL "$source_lib" "$target_lib" || exit 1')
	script.append('  else')
	script.append('    echo "ERROR: libdav1d.a not found in $install_dir"')
	script.append('    exit 1')
	script.append('  fi')
	script.append('fi')
	
	if not env.RunExternalCommand(script):
		raise Exception('Failed building libdav1d')

if buildStaticLinking:
	targets = [staticFileName]
else:
	targets = [libFileName]
targets.extend([
	'include/dav1d/common.h',
	'include/dav1d/data.h',
	'include/dav1d/dav1d.h',
	'include/dav1d/headers.h',
	'include/dav1d/picture.h',
	'include/dav1d/version.h'])

if envLibrary['platform_android'] != 'no':
	if envLibrary['ANDROID_ARCH'] == 'aarch':
		envLibrary.Replace(CROSS_FILE=envLibrary.File('aarch64-android.meson').srcnode())
	elif envLibrary['ANDROID_ARCH'] == 'arm':
		envLibrary.Replace(CROSS_FILE=envLibrary.File('arm-android.meson').srcnode())
elif envLibrary['platform_webwasm']:
	envLibrary.Replace(CROSS_FILE=envLibrary.File('dav1d-{}/package/crossfiles/wasm64.meson'.format(libVersion)))

library = envLibrary.Command(targets,
	[nodeArtifacts, patches],
	envLibrary.Action(libdav1dBuild, 'Build libdav1d'))

depends = envLibrary.Alias('lib_libdav1d', library)

envLibrary.Clean(library, ['bin', 'include', 'lib', 'share', srcdir, 'build_dir'])

cpppath = [envLibrary.Dir('include')]

libpath = [envLibrary.Dir('lib')]

if buildStaticLinking:
	libs = library[0:1]
	runtimelibs = []
else:
	runtimelibs = library[0:1]
	libs = [libLinkName]

parent_targets['lib_libdav1d'] = {
	'name' : 'Internal libdav1d library',
	'cpppath' : cpppath,
	'libpath' : libpath,
	'libs' : libs,
	'runtimelibs' : runtimelibs,
	'depends' : depends }
