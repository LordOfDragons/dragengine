namespace Dragengine.Gui

pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Utils
pin Dragengine.Scenery
pin Dragengine.Commands


/**
 * \brief Console window.
 * 
 * Shows the most recent output of a Console object and provides support for
 * developers and players to run console commands.
 * 
 * Supports designing using designer selector "Window.Console".
 */
class WindowConsole extends Window implements ConsoleListener
	var Console pConsole
	var ConsoleCommandList pConsoleCommands
	var CommandManager pCommandManager
	var TextLayout pTextLayout
	var Widget pWidgetBufferLines
	var ConsoleInputField pEditInput
	var bool pHasChanged
	
	
	
	/**
	 * \brief Create console window.
	 * 
	 * Default size is entire width of screen and half the height.
	 * 
	 * Window is initially hidden. Use CommandToggleConsole to show/hide the window.
	 */
	func new() this(0, 0, GraphicSystem.getWindowWidth(), GraphicSystem.getWindowHeight() / 2)
	end
	
	/**
	 * \brief Create console window.
	 * 
	 * Window is initially hidden. Use CommandToggleConsole to show/hide the window.
	 */
	func new(int x, int y, int width, int height) super(x, y, width, height)
		setLayout(BorderLayout.new(2))
		setCanClose(false)
		setVisible(false)
		setCanMaximize(false)
		setCanMinimize(false)
		setDesignerSelector("WindowConsole")
		
		pHasChanged = false
		pConsoleCommands = ConsoleCommandList.new()
		
		pWidgetBufferLines = Widget.new()
		addWidget(pWidgetBufferLines, BorderLayout.Area.content)
		
		pEditInput = ConsoleInputField.new()
		addWidget(pEditInput, BorderLayout.Area.bottom)
		
		setActiveWidget(pEditInput)
	end
	
	/** \brief Dispose of widget. */
	func void dispose()
		if pConsole != null
			pConsole.removeListener(this)
		end
		
		pCommandManager = null
		pConsoleCommands = null
		pWidgetBufferLines = null
		
		super.dispose()
	end
	
	
	
	/** \brief Console to monitor. */
	func Console getConsole()
		return pConsole
	end
	
	/** \brief Set console to monitor. */
	func void setConsole(Console console)
		if console == pConsole
			return
		end
		
		if pConsole != null
			pConsole.removeListener(this)
		end
		
		pConsole = console
		
		if console != null
			console.addListener(this)
		end
		
		pHasChanged = true
		if getVisible()
			updateCanvasConsole()
		end
		
		pEditInput.setConsole(console)
	end
	
	/** \brief List of console commands users can enter into the input field. */
	func ConsoleCommandList getConsoleCommands()
		return pConsoleCommands
	end
	
	/** \brief Set list of console commands users can enter into the input field. */
	func void setConsoleCommands(ConsoleCommandList commands)
		if commands == pConsoleCommands
			return
		end
		
		pConsoleCommands = commands
		pEditInput.setConsoleCommands(commands)
	end
	
	/** \brief Command manager for commands users can enter into the input field. */
	func CommandManager getCommandManager()
		return pCommandManager
	end
	
	/** \brief Set command manager for commands users can enter into the input field. */
	func void setCommandManager(CommandManager commandManager)
		if commandManager == pCommandManager
			return
		end
		
		pCommandManager = commandManager
		
		pEditInput.setCommands(commandManager)
	end
	
	/** \brief Edit field for entering console commands. */
	func ConsoleInputField getEditInput()
		return pEditInput
	end
	
	/** \brief Set command for closing console. */
	func void setCommandCloseConsole(Command command)
		pEditInput.setCommandCloseConsole(command)
	end
	
	
	
	/** \brief Window is shown. */
	func void onShown(WidgetEvent event)
		super.onShown(event)
		updateCanvasConsole()
	end
	
	/** \brief Gui theme changed. */
	func void onGuiThemeChanged()
		super.onGuiThemeChanged()
		updateCanvasConsole()
	end
	
	/** \brief Desktop size changed. */
	func void onDesktopResized()
		setSize(Point.new(GraphicSystem.getWindowWidth(), GraphicSystem.getWindowHeight() / 2))
	end
	
	/** \brief Window has been resized. */
	func void onResize(WidgetEvent event)
		super.onResize(event)
		updateCanvasConsole()
	end
	
	
	
	/** \brief Update canvas console if required. */
	func void updateCanvasConsole()
		if not pHasChanged
			return
		end
		
		var CanvasView canvas = pWidgetBufferLines.getCanvasContent()
		canvas.removeAllCanvas()
		
		updateBuffer()
		
		if pTextLayout != null
			pTextLayout.addToCanvas(canvas, 2, getHeight() - 3 \
				- pEditInput.getHeight() - pEditInput.getBorderSize().getHeight() \
				- pTextLayout.getHeight())
		end
		
		pHasChanged = false
	end
	
	
	
	/** \brief Message added to console. */
	func void messageAdded(Console console, ConsoleMessage message, bool removedTop)
		pHasChanged = true
		if getVisible()
			updateCanvasConsole()
		end
	end
	
	/** \brief Console cleared. */
	func void consoleCleared(Console console)
		pHasChanged = true
		if getVisible()
			updateCanvasConsole()
		end
	end
	
	
	
	/** \brief Update buffer. */
	private func void updateBuffer()
		// NOTE
		// building a layout out of a large number of log messages (for example 100)
		// can be up to 10ms slow or more due to TextLayout being a script class and
		// not running fast for building larg layouts.
		// 
		// TODO
		// replace this with a more intelligent solution like a FlowLayout in Y Axis
		// with Label widgets for each log message. this way the TextLayout class
		// operates on smaller batches of text and messages can be added to the end
		// and removed from the top. Layouting would then be automatic
		
		if pConsole == null
			pTextLayout = null
			return
		end
		
		var Font font = getFont()
		var Color color = getTextColor()
		if font == null or color == null
			pTextLayout = null
			return
		end
		
		var int i, count = pConsole.getMessageCount()
		var String buffer = ""
		var int width = getWidth()
		
		// build buffer containing all text
		for i = 0 to count
			var ConsoleMessage message = pConsole.getMessage(i)
			if i > 0
				buffer = buffer + "\n"
			end
			buffer = buffer + "[" + message.getTimeStamp() + "] "
			if message.getSource() != null
				buffer = buffer + message.getSource() + ": "
			end
			buffer = buffer + message.getMessage()
		end
		
		// build layout
		if count > 0
			pTextLayout = TextLayout.new(buffer, font)
			pTextLayout.setColor(color)
			pTextLayout.setBorderColor(getTextBorderColor())
			pTextLayout.setBorderThickness(getTextBorderThickness())
			pTextLayout.setDilation(getTextDilation())
			pTextLayout.setAlignment(TextLayout.Align.left)
			pTextLayout.setMaximalWidth(DEMath.max(width - 10, 0))
			pTextLayout.layoutText()
			
		else
			pTextLayout = null
		end
	end
end
