namespace Dragengine.Gui

pin Dragengine.Gui.Events
pin Dragengine.Utils
pin Dragengine.Scenery


/**
 * \brief Shout last console messages transparently onto screen for short amount of time.
 * 
 * Supports designing using designer selector "ShoutConsole".
 */
class ShoutConsole extends Widget implements ConsoleListener
	/** \brief Update timer. */
	class UpdateTimer extends Timer
		var ShoutConsole pWidget
		
		func new(ShoutConsole widget) super(1.0, true)
			pWidget = widget
		end
		
		func void fire()
			pWidget.update()
		end
	end
	
	
	
	var Console pConsole
	var Array pTextLayouts
	var Array pTimesToLive
	var int pMaxLines
	var float pNewMessageTTL
	var UpdateTimer pUpdateTimer
	
	
	
	/** \brief Create shout console. */
	func new(Console console)
		pTextLayouts = Array.new(10)
		pTimesToLive = Array.new(10)
		pMaxLines = 5
		pNewMessageTTL = 5 //3
		
		setDesignerSelector("ShoutConsole")
		setMinimumSize(Point.new(100, 100))
		
		setConsole(console)
		
		pUpdateTimer = UpdateTimer.new(this)
	end
	
	/** \brief Dispose of widget. */
	func void dispose()
		if pUpdateTimer != null
			pUpdateTimer.giveUp()
			pUpdateTimer = null
		end
		
		if pConsole != null
			pConsole.removeListener(this)
			pConsole = null
		end
		
		super.dispose()
	end
	
	
	
	/** \brief Console to monitor. */
	func Console getConsole()
		return pConsole
	end
	
	/** \brief Set console to monitor. */
	func void setConsole(Console console)
		if console == pConsole
			return
		end
		
		if pConsole != null
			pConsole.removeListener(this)
		end
		
		pConsole = console
		
		if console != null
			console.addListener(this)
		end
	end
	
	
	
	/**
	 * \brief Message added to console.
	 *
	 * \param console Console sending notification.
	 * \param message Message added to console.
	 * \param removedTop True if topmost message had to be removed to be able to add message.
	 */
	func void messageAdded(Console console, ConsoleMessage message, bool removedTop)
		// TODO change this to a list of Label with wrapping support to avoid depending
		//      on the presence of a gui theme while building the text layouts
		//      
		var Color color = getTextColor()
		var Font font = getFont()
		if font == null or color == null
			return // no gui theme yet
		end
		
		var int count = pTextLayouts.getCount()
		var int width = getWidth()
		var String messageText = ""
		
		// build text to display from message
		if message.getSource() != null
			messageText = messageText + message.getSource() + ": "
		end
		messageText = messageText + message.getMessage()
		
		// create text layout for this message text
		var TextLayout layout = TextLayout.new(messageText, font)
		layout.setColor(color)
		layout.setAlignment(TextLayout.Align.left)
		layout.setMaximalWidth(DEMath.max(width - 10, 0))
		layout.layoutText()
		
		// drop lines if buffer is full
		if count == pMaxLines
			pTextLayouts.removeFrom(0)
			pTimesToLive.removeFrom(0)
		end
		
		// add new message
		pTextLayouts.add(layout)
		pTimesToLive.add(pNewMessageTTL)
		
		updateCanvasConsole()
	end
	
	/**
	 * \brief Console cleared.
	 *
	 * \param console Console sending notification.
	 */
	func void consoleCleared(Console console)
		clear()
	end
	
	
	
	/** \brief Clear window. */
	func void clear()
		pTextLayouts.removeAll()
		pTimesToLive.removeAll()
		updateCanvasConsole()
	end
	
	
	
	/**
	 * \brief Update console.
	 * \details Remove timed out console logs.
	 */
	func void update()
		var float elapsed = pUpdateTimer.getTriggerTime()
		var int i, count = pTextLayouts.getCount()
		var bool changed = false
		
		// update all time to live counters
		for i = 0 to count
			pTimesToLive.setAt(i, (pTimesToLive.getAt(i) cast float) - elapsed)
		end
		
		// remove all message which have died
		while count > 0
			if pTimesToLive.getAt(0) cast float > 0
				break
			end
			pTextLayouts.removeFrom(0)
			pTimesToLive.removeFrom(0)
			count--
			changed = true
		end
		
		// update if something changed
		if changed
			updateCanvasConsole()
		end
	end
	
	
	
	/**
	 * \brief Widget at coordinates or \em null if not found.
	 * 
	 * Overwritten to always return \em null. Prevents this widget from hovering. Keep this
	 * in mind if you try to call this method. It might not work. If you need original
	 * getWidgetAt behavior from super class use realGetWidgetAt().
	 */
	func Widget getWidgetAt(Point position)
		return null
	end
	
	/** \brief Super class getWidgetAt without overwritten behavior. */
	func Widget realGetWidgetAt(Point position)
		return super.getWidgetAt(position)
	end
	
	
	
	/** \brief Size changed. */
	func void onResize(WidgetEvent event)
		super.onResize(event)
		
		// TODO: this has to be done more clever
		pTextLayouts.removeAll()
		pTimesToLive.removeAll()
		updateCanvasConsole()
	end
	
	/** \brief Update console canvas. */
	func void updateCanvasConsole()
		var CanvasView canvas = getCanvasContent()
		canvas.removeAllCanvas()
		
		var int count = pTextLayouts.getCount()
		var int y = 0
		var int i
		
		for i = 0 to count
			var TextLayout layout = pTextLayouts.getAt(i) cast TextLayout
			layout.addToCanvas(canvas, 0, y)
			y += layout.getHeight()
		end
	end
end

