	/** \brief Add commands to command manager. */
	static func void addCommands(CommandManager commands, ECBehaviorPlayerControllable.Tracker tracker)
		addMovementCommands(commands, tracker)
		addCrouchCommands(commands, tracker)
		addRunCommands(commands, tracker)
	end
	
	/**
	 * \brief Add commands to command manager.
	 * \version 1.35
	 */
	static func void addCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker, PlayerControlledActorSelector trackerSelector)
		addMovementCommands(commands, tracker, trackerSelector)
		addCrouchCommands(commands, tracker, trackerSelector)
		addRunCommands(commands, tracker, trackerSelector)
	end
	
	/**
	 * \brief Add movement commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Move*, Look*, AnalogMove* and AnalogLook*.
	 */
	static func void addMovementCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker)
		addMovementCommands(commands, tracker, null)
	end
	
	/**
	 * \brief Add movement commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Move*, Look*, AnalogMove* and AnalogLook*.
	 */
	static func void addMovementCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker, PlayerControlledActorSelector trackerSelector)
		commands.add(MoveForward.new(tracker, trackerSelector))
		commands.add(MoveBackward.new(tracker, trackerSelector))
		commands.add(MoveLeft.new(tracker, trackerSelector))
		commands.add(MoveRight.new(tracker, trackerSelector))
		
		commands.add(LookLeft.new(tracker, trackerSelector))
		commands.add(LookRight.new(tracker, trackerSelector))
		commands.add(LookUp.new(tracker, trackerSelector))
		commands.add(LookDown.new(tracker, trackerSelector))
		
		commands.add(AnalogMoveFB.new(tracker, trackerSelector))
		commands.add(AnalogMoveLR.new(tracker, trackerSelector))
		commands.add(AnalogLookLR.new(tracker, trackerSelector))
		commands.add(AnalogLookUD.new(tracker, trackerSelector))
	end
	
	/**
	 * \brief Add crouch commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Crouch and ToggleCrouch.
	 */
	static func void addCrouchCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker)
		addCrouchCommands(commands, tracker, null)
	end
	
	/**
	 * \brief Add crouch commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Crouch and ToggleCrouch.
	 */
	static func void addCrouchCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker, PlayerControlledActorSelector trackerSelector)
		commands.add(Crouch.new(tracker, trackerSelector))
		commands.add(ToggleCrouch.new(tracker, trackerSelector))
	end
	
	/**
	 * \brief Add run commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Run and ToggleRun.
	 */
	static func void addRunCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker)
		addRunCommands(commands, tracker, null)
	end
	
	/**
	 * \brief Add run commands to command manager.
	 * \version 1.35
	 * 
	 * Adds Run and ToggleRun.
	 */
	static func void addRunCommands(CommandManager commands,\
	ECBehaviorPlayerControllable.Tracker tracker, PlayerControlledActorSelector trackerSelector)
		commands.add(Run.new(tracker, trackerSelector))
		commands.add(ToggleRun.new(tracker, trackerSelector))
	end
	
	
	
	/** \brief Input scheme to use for adding default bindings. */
	enum InputScheme
		/** \brief DYXC. */
		dyxc
		
		/** \brief WASD. */
		wasd
	end
	
	/**
	 * \brief Add default bindings for commands.
	 * 
	 * Adds bindings for these commands:
	 * - "moveForward"
	 * - "moveBackward"
	 * - "moveLeft"
	 * - "moveRight"
	 * - "lookLeft"
	 * - "lookRight"
	 * - "lookUp"
	 * - "lookDown"
	 * - "analogMoveFB"
	 * - "analogMoveLR"
	 * - "analogLookLR"
	 * - "analogLookUD"
	 * - "toggleCrouch"
	 * - "toggleRun"
	 * 
	 * These commands are not added as bindings:
	 * - "crouch"
	 * - "run"
	 */
	static func void addDefaultBindings(DefaultBindingHelper helper, InputScheme scheme)
		select scheme
		case InputScheme.dyxc
			if helper.hasMouse()
				helper.mouseBindMove("analogLookLR", "analogLookUD")
			end
			
			if helper.hasKeyboard()
				helper.keyboardBindKeyCode(InputEventKey.d, "moveForward")
				helper.keyboardBindKeyCode(InputEventKey.c, "moveBackward")
				helper.keyboardBindKeyCode(InputEventKey.y, "moveLeft")
				helper.keyboardBindKeyCode(InputEventKey.v, "moveRight")
				helper.keyboardBindKeyCode(InputEventKey.arrowLeft, "lookLeft")
				helper.keyboardBindKeyCode(InputEventKey.arrowRight, "lookRight")
				helper.keyboardBindKeyCode(InputEventKey.arrowUp, "lookUp")
				helper.keyboardBindKeyCode(InputEventKey.arrowDown, "lookDown")
				helper.keyboardBindKeyCode(InputEventKey.x, "toggleCrouch")
				helper.keyboardBindKeyCode(InputEventKey.s, "toggleRun")
			end
			
		case InputScheme.wasd
			if helper.hasMouse()
				helper.mouseBindMove("analogLookLR", "analogLookUD")
			end
			
			if helper.hasKeyboard()
				helper.keyboardBindKeyCode(InputEventKey.w, "moveForward")
				helper.keyboardBindKeyCode(InputEventKey.s, "moveBackward")
				helper.keyboardBindKeyCode(InputEventKey.a, "moveLeft")
				helper.keyboardBindKeyCode(InputEventKey.d, "moveRight")
				helper.keyboardBindKeyCode(InputEventKey.arrowLeft, "lookLeft")
				helper.keyboardBindKeyCode(InputEventKey.arrowRight, "lookRight")
				helper.keyboardBindKeyCode(InputEventKey.arrowUp, "lookUp")
				helper.keyboardBindKeyCode(InputEventKey.arrowDown, "lookDown")
				helper.keyboardBindKeyCode(InputEventKey.c, "toggleCrouch") // or control
				helper.keyboardBindKeyCode(InputEventKey.shift, InputEventKeyLocation.left, "toggleRun")
			end
			
		else
			throw EInvalidParam.new()
		end
		
		helper.getGamepads().forEach(block InputDevice each
			if helper.gamepadBindStick(each, 0, "analogMoveLR", "analogMoveFB")
				helper.gamepadBindButton(each, 0, InputDeviceButtonType.stick, "toggleCrouch")
				helper.gamepadBindStick(each, 1, "analogLookLR", "analogLookUD")
				
			else
				helper.gamepadBindAxis(each, 0, "analogMoveLR")
				helper.gamepadBindAxis(each, 1, "analogMoveFB")
				helper.gamepadBindAxis(each, 2, "analogLookLR")
				helper.gamepadBindAxis(each, 3, "analogLookUD")
				helper.gamepadBindAxis(each, 4, "toggleCrouch")
			end
		end)
		
		if helper.hasVRHand(true)
			helper.vrHandBindStick(true, InputDeviceAxisType.stick, 0, "analogLookLR", "")
		end
		
		if helper.hasVRHand(false)
			helper.vrHandBindStick(false, InputDeviceAxisType.stick, 0, "analogMoveLR", "analogMoveFB")
		end
	end
end
