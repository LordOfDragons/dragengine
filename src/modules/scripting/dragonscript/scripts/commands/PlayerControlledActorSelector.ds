namespace Dragengine.Commands
pin Dragengine.Scenery


/**
 * \brief Interface selecting \ref ECBehaviorPlayerControllable.Tracker matching binding.
 * \version 1.35
 * 
 * This interface is useful for situations where bindings for the same command exist for multiple
 * input devices and the input device producing the input is relevant. This is the case for
 * example for local multiplayer games where input devices are assigned to individual players.
 * This interface is presented the \ref Binding which produced the input and returns the
 * \ref ECBehaviorPlayerControllable.Tracker to use.
 */
interface PlayerControlledActorSelector
	/**
	 * \brief Select \ref ECBehaviorPlayerControllable.Tracker matching binding.
	 */
	func ECBehaviorPlayerControllable.Tracker getPlayerControlledActor(Binding binding)
end
