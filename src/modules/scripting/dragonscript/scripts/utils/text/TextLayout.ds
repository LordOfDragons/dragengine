namespace Dragengine.Utils

pin Dragengine.Gui
pin Dragengine.Scenery


/**
 * Takes a text and formats it to fit into a predefined area.
 * Help creating canvas for rendering.
 */
class TextLayout
	/** \brief Text alignment. */
	enum Align
		/** Align text left side. */
		left
		
		/** Align text right side. */
		right
		
		/** Align text center. */
		center
	end
	
	
	var String pText
	var Align pAlignment
	var Font pFont
	var Color pColor, pBorderColor
	var float pBorderThickness, pDilation
	var Array pLines
	var int pWidth, pHeight, pMaxWidth
	var bool pAtLeastOneLine
	
	
	/** Creates a new TextLayout object. */
	func new(String text, Font font)
		if text == null or font == null
			throw EInvalidParam.new()
		end
		
		pText = text
		pLines = Array.new()
		pAlignment = Align.left
		pFont = font
		pColor = Color.black
		pBorderColor = Color.black
	end
	
	/**
	 * Creates a new TextLayout object using the attributes stored
	 * in another TextLayout object but using a different max width.
	 */
	func new(TextLayout layout, int width)
		if layout == null or width < 0
			throw EInvalidParam.new()
		end
		
		pText = layout.pText
		pLines = Array.new()
		pAlignment = layout.pAlignment
		pFont = layout.pFont
		pColor = layout.pColor
		pBorderColor = layout.pBorderColor
		pBorderThickness = layout.pBorderThickness
		pDilation = layout.pDilation
		pMaxWidth = width
	end
	
	
	
	/** Layout text. */
	func String getText()
		return pText
	end
	
	/** Set layout text. */
	func void setText(String text)
		if text == null
			throw EInvalidParam.new()
		end
		pText = text
	end
	
	/** Align.of text. */
	func Align getAlignment()
		return pAlignment
	end
	
	/** Set alignement of text. */
	func void setAlignment(Align alignment)
		pAlignment = alignment
	end
	
	/** Font. */
	func Font getFont()
		return pFont
	end
	
	/** Set font. */
	func void setFont(Font font)
		if font == null
			throw EInvalidParam.new()
		end
		pFont = font
	end
	
	/** Color. */
	func Color getColor()
		return pColor
	end
	
	/** Set color. */
	func void setColor(Color color)
		if color == null
			throw EInvalidParam.new()
		end
		pColor = color
	end
	
	/**
	 * \brief Border color.
	 * \version 1.35
	 */
	func Color getBorderColor()
		return pBorderColor
	end
	
	/**
	 * \brief Set border color.
	 * \version 1.35
	 */
	func void setBorderColor(Color color)
		if color == null
			throw ENullPointer.new()
		end
		pBorderColor = color
	end
	
	/**
	 * \brief Border thickness in percentage of the font size or null.
	 * \version 1.35
	 * 
	 * A good starting value for balanced border size is 0.075 (7.5%) to 0.1 (10%).
	 */
	func float getBorderThickness()
		return pBorderThickness
	end
	
	/**
	 * \brief Set border thickness in percentage of the font size or null.
	 * \version 1.35
	 * 
	 * A good starting value for balanced border size is 0.075 (7.5%) to 0.1 (10%).
	 */
	func void setBorderThickness(float thickness)
		pBorderThickness = thickness
	end
	
	/**
	 * \brief Dilation in percentage of the font size.
	 * \version 1.35
	 */
	func float getDilation()
		return pDilation
	end
	
	/**
	 * \brief Set dilation in percentage of the font size.
	 * \version 1.35
	 */
	func void setDilation(float dilation)
		pDilation = dilation
	end
	
	/** Maximal width of the layout text. */
	func int getMaximalWidth()
		return pMaxWidth
	end
	
	/** Set maximal text width. */
	func void setMaximalWidth(int width)
		if width < 0
			throw EInvalidParam.new()
		end
		pMaxWidth = width
	end
	
	/** No lines are present. */
	func bool getAtLeastOneLine()
		return pAtLeastOneLine
	end
	
	/** Set if there is at least one one present. */
	func void setAtLeastOneLine(bool atLastOneLine)
		pAtLeastOneLine = atLastOneLine
	end
	
	
	
	/** Width of the layout text. */
	func int getWidth()
		return pWidth
	end
	
	/** Height of the layout text. */
	func int getHeight()
		return pHeight
	end
	
	/** Number of lines on the layout text. */
	func int getLineCount()
		return pLines.getCount()
	end
	
	/** Line by index. */
	func TextLayoutLine getLine(int index)
		return pLines.getAt(index) cast TextLayoutLine
	end
	
	
	
	/** Lay out text. */
	func void layoutText()
		var UTF8Decoder decoder = UTF8Decoder.new(pText, 0)
		var float fmaxWidth = pMaxWidth cast float
		var int lineHeight = pFont.getSize()
		var TextLayoutLine textLine
		var bool keepLooping = true
		var int wordCharacters
		var float characterAdvance, characterExtend
		var int lineStart, wordStart, wordCount
		var float wordWidth, spacesWidth, lineWidth
		var float wordExtend, lineExtend, lineReach
		var int lineEnd, nextPosition, lastPosition
		var int x, y, character
		var bool hasLines
		var float dilation = DEMath.max(pDilation + pBorderThickness, 0.0) * lineHeight * 2
		var float ceilDilation = DEMath.ceil(dilation)
		
		lineHeight += ceilDilation cast int
		fmaxWidth = DEMath.max(fmaxWidth - ceilDilation, 0.0)
		
		// loop through the text and create lines
		pWidth = pHeight = 0
		pLines = Array.new()
		
		while keepLooping
			lastPosition = nextPosition
			if decoder.hasReachedEnd()
				character = '\n'
				keepLooping = false
			else
				character = decoder.decodeNextCharacter()
			end
			nextPosition = decoder.getPosition()
			
//BaseGameApp.getApp().getConsole().addMessage("round: c=" + (character cast byte) + " wc=" + wordCharacters + \
//" ls=" + lineStart + " le=" + lineEnd + " ws=" + wordStart + " wc=" + wordCount + " sw=" + spacesWidth + \
//" lw=" + lineWidth + " ww=" + wordWidth + " np=" + nextPosition + " lp=" + lastPosition + "\n")
			
			if character == '\n'
				lineReach = DEMath.max(lineExtend, lineWidth + spacesWidth + wordExtend)
				if wordCharacters == 0
					if lineWidth == 0 // only spaces on line
						textLine = TextLayoutLine.new(lineStart, lineEnd - lineStart, \
							DEMath.ceil(DEMath.max(spacesWidth, lineReach) + dilation) cast int, lineHeight)
						
					else
						textLine = TextLayoutLine.new(lineStart, lineEnd - lineStart, \
							DEMath.ceil(DEMath.max(lineWidth, lineReach) + dilation) cast int, lineHeight)
					end
					
				else
					textLine = TextLayoutLine.new(lineStart, lastPosition - lineStart, \
						DEMath.ceil(DEMath.max(lineWidth + spacesWidth + wordWidth, lineReach) + dilation) cast int, lineHeight)
				end
//BaseGameApp.getApp().getConsole().addMessage("new line: text='" + pText.substring(textLine.getFirstChar(),\
//textLine.getFirstChar() + textLine.getCharCount()) + "' width=" + textLine.getWidth() + " height=" + textLine.getHeight() + "\n")
				lineStart = nextPosition
				wordStart = lineStart
				lineEnd = lineStart
				wordCharacters = wordCount = 0
				wordWidth = wordExtend = lineWidth = lineExtend = spacesWidth = 0
				
			elif character != -1
				characterAdvance = pFont.getCharAdvance(character)
				characterExtend = pFont.getCharWidth(character) - pFont.getCharBearing(character) - characterAdvance
//BaseGameApp.getApp().getConsole().addMessage("test: cw=" + characterAdvance + " mw=" + pMaxWidth + "\n")
				
				if pMaxWidth > 0 and wordCount > 1 and lineWidth + wordWidth + characterAdvance + characterExtend > fmaxWidth
					// word break
					//if wordCount > 1
						textLine = TextLayoutLine.new(lineStart, lineEnd - lineStart, \
							DEMath.ceil(DEMath.max(lineWidth, lineExtend) + dilation) cast int, lineHeight)
						lineStart = wordStart
						lineExtend = 0
						if wordCharacters == 0
							wordCount = 0 // same conditions bumps value up by one later
						else
							wordCount = 1 // nobody bumps anymore so we have to do so
						end
					// character break
					/*else
						if wordCount == 1
							textLine = TextLayoutLine.new(lineStart, lastPosition - lineStart, \
								lineWidth + wordWidth + dilation, lineHeight)
						end
						lineStart = lastPosition
						wordStart = lastPosition
						wordCharacters = 0
						wordWidth = 0
						wordCount = 0
					end*/
					lineEnd = lastPosition
					lineWidth = spacesWidth = 0
				end
				
				if isWhiteSpace(character)
					if wordCount == 0 and hasLines
						lineStart = nextPosition
						lineEnd = nextPosition
						lineExtend = spacesWidth = 0
					else
						if wordCharacters > 0
							lineEnd = lastPosition
							lineExtend = DEMath.max(lineExtend, lineWidth + spacesWidth + wordExtend)
							lineWidth += spacesWidth + wordWidth
							spacesWidth = 0
						end
						spacesWidth += characterAdvance
					end
					wordStart = nextPosition
					wordCharacters = 0
					wordWidth = wordExtend = 0
				else
					if wordCharacters == 0
						wordCount++
					end
					wordCharacters++
					wordWidth += characterAdvance
					wordExtend = DEMath.max(wordExtend, wordWidth + characterExtend)
				end
			end
			
			if textLine != null
				if textLine.getWidth() > pWidth
					pWidth = textLine.getWidth()
				end
				pHeight += textLine.getHeight()
				textLine.setY(y)
				y += textLine.getHeight()
				pLines.add(textLine)
				hasLines = true
				textLine = null
			end
		end
		
		// if the last character is a newline or there is no line but atleastoneline
		// is set we have to add an empty line
		if pAtLeastOneLine and not hasLines
			textLine = TextLayoutLine.new(0, 0, 0, lineHeight)
			textLine.setY(y)
			pLines.add(textLine)
		end
		
		// determine location of lines depending on alignement
		pLines.forEach(block TextLayoutLine each
			if pAlignment == Align.left
				x = 0
				
			elif pAlignment == Align.right
				x = pWidth - each.getWidth()
				
			else
				x = (pWidth - each.getWidth()) / 2
			end
			
			each.setX(x)
//BaseGameApp.getApp().getConsole().addMessage("" + i + ": text='" + pText.substring(textLine.getFirstChar(),\
//textLine.getFirstChar() + textLine.getCharCount()) + "' width=" + textLine.getWidth() + " height=" + textLine.getHeight() + "\n")
		end)
	end
	
	/** Character is a white space character. */
	private func bool isWhiteSpace(int char)
		if char == ' ' or char == '\t'
			return true
		end
		return false
	end
	
	
	
	/**
	 * Add canvas for each line. Canvas has to be of type Canvas.VIEW.
	 * Caller is responsible to remove all canvas if required.
	 */
	func void addToCanvas(CanvasView canvas, int x, int y)
		pLines.forEach(block TextLayoutLine each
			each.addToCanvas(this, canvas, x, y)
		end)
	end
end
