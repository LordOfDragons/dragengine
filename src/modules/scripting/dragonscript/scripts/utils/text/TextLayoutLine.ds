namespace Dragengine.Utils

pin Dragengine.Gui
pin Dragengine.Scenery


/**
 * Line of text in a TextLayout object. All needed information are stored in
 * the text line object. Can add a text canvas representing the line to a
 * view canvas.
 */
class TextLayoutLine
	var int pFirstChar, pCharCount, pX, pY, pWidth, pHeight
	
	
	
	/** Creates a new text line with the given parameters. */
	 func new(int first, int count, int width, int height)
		if first < 0 or count < 0 or width < 0 or height < 0
			throw EInvalidParam.new()
		end
		
		pFirstChar = first
		pCharCount = count
		pWidth = width
		pHeight = height
	end
	
	
	
	/** Index of first character in the line. */
	func int getFirstChar()
		return pFirstChar
	end
	
	/** Number of characters in the line. */
	func int getCharCount()
		return pCharCount
	end
	
	/** Width of the line. */
	func int getWidth()
		return pWidth
	end
	
	/** Height of the line. */
	func int getHeight()
		return pHeight
	end
	
	
	
	/** X position of the line. */
	func int getX()
		return pX
	end
	
	/** Set x position of text line. */
	func void setX(int x)
		pX = x
	end
	
	/** Y position of the line. */
	func int getY()
		return pY
	end
	
	/** Set y position of text line. */
	func void setY(int y)
		pY = y
	end
	
	
	
	/**
	 * Add text canvas for layout line to view type canvas.
	 * The order of the created canvas is set to the count of canvas.
	 */
	func void addToCanvas(TextLayout layout, CanvasView canvas, int x, int y)
		if pCharCount == 0
			return
		end
		
		var CanvasText lineCanvas = CanvasText.new()
		lineCanvas.setFont(layout.getFont())
		lineCanvas.setColor(layout.getColor())
		lineCanvas.setText(layout.getText().substring(pFirstChar, pFirstChar + pCharCount))
		lineCanvas.setPosition(Point.new(x + pX, y + pY))
		
		lineCanvas.setOrder(canvas.getCanvasCount() cast float)
		canvas.addCanvas(lineCanvas)
	end
end
