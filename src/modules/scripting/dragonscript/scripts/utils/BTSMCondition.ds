namespace Dragengine.Utils
pin Dragengine.BehaviorTreeSystem
pin Dragengine.StateMachineSystem


/**
 * \brief \ref BTSMActionCondition tailored for condition use (action behaves as condition).
 * \version 1.35
 * 
 * This class is useful to use the same set of actions and conditions for both behavior
 * trees and state machines. State machine actions throw an exception if the shared action
 * returns \ref BTResult#failure.
 * 
 * Overwrite \ref BTSMCondition#evaluateConditionShared(String,Object,Dictionary).
 * 
 * Typical usage looks like this (inside an \ref Scenery.DefaultECBehaviorInstance subclass):
 * \code
 * class BTACheck extends BTSMCondition
 *   var Instance pInstance
 *   
 *   func new(Instance instance, String prefix) super(prefix)
 *     pInstance = instance
 *   end
 *   
 *   func bool evaluateConditionShared(String prefix, Object context, Dictionary parameters)
 *     var bool result = true
 *     
 *     var Object value = parameters.getAt(prefix + "parameterName", null)
 *     if value != null
 *       result &= pInstance.getSomething() == value.equals("true")
 *     end
 *     
 *     return result
 *   end
 * end
 * \endcode
 * 
 * And adding it to \ref ECComposeBTSM.Instance like this (in \ref Scenery.DefaultECBehaviorInstance#init()):
 * \code
 * if pECBehavior.getBTSMs().hasAny()
 *   var String prefix = pECBehavior.getPrefix()
 *   var ECComposeBTSM.Instance btsms = ECComposeBTSM.Instance.new(getElement(), pECBehavior.getBTSMs())
 *   btsms.addAllActionCondition(prefix, "check", BTACheck.new(this, prefix))
 * end
 * \endcode
 */
class BTSMCondition extends BTSMActionCondition
	var String pPrefix, pWaitParameter
	
	
	/**
	 * \brief Create shared behavior tree and state machine action and condition.
	 * 
	 * Prefix is typically the behavior element behavior prefix. For example for
	 * \ref Scenery.ECBehaviorSpeaker the prefix would be "speaker.".
	 */
	func new(String prefix) this(prefix, "wait")
	end
	
	/** \brief Create shared behavior tree and state machine action and condition. */
	func new(String prefix, String waitParameter)
		if prefix == null
			throw ENullPointer.new("prefix")
		end
		if waitParameter == null
			throw ENullPointer.new("waitParameter")
		end
		
		pPrefix = prefix
		pWaitParameter = waitParameter
	end
	
	
	/**
	 * \brief Prefix for condition parameter names.
	 * \version 1.35
	 */
	func String getPrefix()
		return pPrefix
	end
	
	/**
	 * \brief Parameter name for wait.
	 * \version 1.35
	 */
	func String getWaitParameterName()
		return pWaitParameter
	end
	
	
	func BTResult runActionShared(Object context, Dictionary parameters)
		if evaluateConditionShared("", context, parameters)
			return BTResult.success
		end
		if parameters.has(pWaitParameter)
			return BTResult.running
		end
		return BTResult.failure
	end
	
	/**
	 * \brief Evaluate condition.
	 * 
	 * Context which can be either \ref BTContext or \ref SMContext. Prefix has to be prepended
	 * to parameter names. For action use prefix is empty string. For condition use prefix is
	 * \ref #getPrefix().
	 * 
	 * Default implementation returns false.
	 */
	func bool evaluateConditionShared(String prefix, Object context, Dictionary parameters)
		return false
	end
	
	
	func bool evaluateConditionShared(Object context, Dictionary parameters)
		return evaluateConditionShared(pPrefix, context, parameters)
	end
end
