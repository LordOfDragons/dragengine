namespace Dragengine
pin Dragengine.Utils
pin Dragengine.BehaviorTreeSystem
pin Dragengine.Gui

/**
 * \brief Game app behavior adding \ref ShoutConsole to \ref WindowGameWorld.
 * \version 1.35
 * \see https://developer.dragondreams.ch/wiki/doku.php/dragengine:modules:dragonscript:gabehavior_shoutconsole
 */
class GABehaviorShoutConsole extends DefaultGABehavior
	/** \brief Action "shoutConsole.update". */
	private class BTSMUpdate extends BTSMActionCondition
		var GABehaviorShoutConsole pInstance
		
		func new(GABehaviorShoutConsole instance)
			pInstance = instance
		end
		
		func BTResult runActionShared(Object context, Dictionary parameters)
			if parameters.has("addToWindow")
				pInstance.addShoutConsole()
			end
			if parameters.has("clear")
				pInstance.getShoutConsole().clear()
			end
			
			var Object value = parameters.getAt("visible", null)
			if value != null
				pInstance.getShoutConsole().setVisible(value.equals("true"))
			end
			
			return BTResult.success
		end
	end
	
	
	var GAComposeBTSM pBTSMs
	var ShoutConsole pShoutConsole
	
	
	/** \brief Create behavior. */
	func new()
	end
	
	
	/** \brief Composable component for state machines. */
	func GAComposeBTSM getBTSM()
		return pBTSMs
	end
	
	/** \brief Shout console or null. */
	func ShoutConsole getShoutConsole()
		return pShoutConsole
	end
	
	
	func void initGame()
		addShoutConsole()
		
		pBTSMs = GAComposeBTSM.new()
		if pBTSMs.hasAny()
			pBTSMs.addAllAction("shoutConsole.", "update", BTSMUpdate.new(this))
		end
	end
	
	func void postInitGame()
		if pShoutConsole != null
			pShoutConsole.clear()
		end
	end
	
	func void cleanUp()
		pBTSMs = null
		
		if pShoutConsole != null
			pShoutConsole.safeDispose()
			pShoutConsole = null
		end
	end
	
	/**
	 * \brief Add shout console to current game world window.
	 * 
	 * If shout console exists it is first disposed of.
	 **/
	func void addShoutConsole()
		var BaseGameApp app = BaseGameApp.getApp()
		var WindowGameWorld window = app.getWindowGameWorld()
		
		if pShoutConsole != null and pShoutConsole.getParent() == window
			return
		end
		
		if pShoutConsole != null
			pShoutConsole.safeDispose()
			pShoutConsole = null
		end
		
		if window != null
			pShoutConsole = ShoutConsole.new(app.getConsole())
			window.addWidget(pShoutConsole)
		end
	end
	
	
	/**
	 * \brief Get behavior in game app or null if absent.
	 * 
	 * Use this method to check if \ref BaseGameApp contains behavior of type \ref GABehaviorShoutConsole.
	 */
	static func GABehaviorShoutConsole getBehaviorInApp()
		return BaseGameApp.getApp().findBehavior(block GABehaviorShoutConsole each
			return true
		end) cast GABehaviorShoutConsole
	end
end
