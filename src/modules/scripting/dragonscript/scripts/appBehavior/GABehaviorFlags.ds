namespace Dragengine.Scenery
pin Dragengine.BehaviorTreeSystem
pin Dragengine.StateMachineSystem
pin Dragengine.Utils

/**
 * \brief Application behavior element adding flags support to behavior trees and state machines.
 * \version 1.35
 * 
 * Behavior adds actions, conditions and events allowing behavior trees and state machines to set,
 * clear and check flags. Flags are stored in the application behavior and are not persisted.
 * 
 * This behavior can be added only once.
 * 
 * The following actions are added:
 * 
 * \par Action "flags.update"
 * 
 * Update flags. The following parameters are supported:
 * 
 * | Parameter | Value | Description |
 * | --- | --- | --- |
 * | set | string | Set named flag |
 * | clear | string | Clear named flag |
 * 
 * \par Action "flags.check"
 * 
 * Check for flag condition. Not existing flags are considered cleared.
 * The following parameters are supported:
 * 
 * | Parameter | Value | Description |
 * | --- | --- | --- |
 * | flag | string | Flag to check |
 * | set | true,false | Flag is set |
 * | wait | | Wait until the flag is set or cleared |
 * | reset | | Toggle flag after checking with all conditions fulfilled |
 * 
 * \par Condition "flags.check"
 * 
 * Check for flag condition. Not existing flags are considered cleared.
 * The following parameters are supported:
 * 
 * | Parameter | Value | Description |
 * | --- | --- | --- |
 * | flags.flag | string | Flag to check |
 * | flags.set | true,false | Flag is set |
 * 
 * \par Event "flags.set:<name>"
 * 
 * Sent to state machines if flag has been set. The name of the flag that has been set is appended
 * to the event name.
 * 
 * \par Event "flags.cleared:<name>"
 * 
 * Sent to state machines if flag has been cleared. The name of the flag that has been cleared is
 * appended to the event name.
 * 
 * \see https://developer.dragondreams.ch/wiki/doku.php/dragengine:modules:dragonscript:gabehavior_flags
 */
class GABehaviorFlags extends DefaultGABehavior
	/** \brief Action "flags.update". */
	private class BTSMUpdate extends BTSMActionCondition
		var GABehaviorFlags pInstance
		
		func new(GABehaviorFlags instance)
			pInstance = instance
		end
		
		func BTResult runActionShared(Object context, Dictionary parameters)
			var Object value = parameters.getAt("set", null)
			if value != null
				pInstance.setFlag(value cast String, true)
			end
			
			value = parameters.getAt("clear", null)
			if value != null
				pInstance.setFlag(value cast String, false)
			end
			
			return BTResult.success
		end
	end
	
	/** \brief Action/condition "flags.check". */
	private class BTSMCheck extends BTSMCondition
		var GABehaviorFlags pInstance
		
		func new(GABehaviorFlags instance) super(instance.getPrefix())
			pInstance = instance
		end
		
		func BTResult runActionShared(Object context, Dictionary parameters)
			var BTResult result = super.runActionShared(context, parameters)
			
			if result == BTResult.success and parameters.has("reset")
				pInstance.toggleFlag(parameters.getAt("flag") cast String)
			end
			
			return result
		end
		
		func bool evaluateConditionShared(String prefix, Object context, Dictionary parameters)
			var String flag = parameters.getAt(prefix + "flag") cast String
			var bool result = true
			
			var Object value = parameters.getAt(prefix + "set", null)
			if value != null
				result &= pInstance.getFlag(flag) == value.equals("true")
			end
			
			return result
		end
	end
	
	
	var GAComposeBTSM pBTSMs
	var String pPrefix
	var Dictionary pFlags
	
	
	/** \brief Create behavior. */
	func new()
		pPrefix = "flags."
		pFlags = Dictionary.new()
	end
	
	
	/** \brief Prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	/** \brief Composable component for state machines. */
	func GAComposeBTSM getBTSM()
		return pBTSMs
	end
	
	
	func void initGame()
		pBTSMs = GAComposeBTSM.new()
		if pBTSMs.hasAny()
			pBTSMs.addAllAction(pPrefix, "update", BTSMUpdate.new(this))
			pBTSMs.addAllActionCondition(pPrefix, "check", BTSMCheck.new(this))
		end
	end
	
	func void cleanUp()
		pBTSMs = null
	end
	
	
	/** \brief Flag is set. */
	func bool getFlag(String name)
		return pFlags.getAt(name, false) cast bool
	end
	
	/** \brief Set flag sending event if the flag changed. */
	func void setFlag(String name, bool flagged)
		if flagged == getFlag(name)
			return
		end
		
		pFlags.setAt(name, flagged)
		
		if pBTSMs != null
			pBTSMs.runEvent(pPrefix, (flagged if "set:" else "cleared:") + name)
		end
	end
	
	/** \brief Toggle flag. */
	func void toggleFlag(String name)
		setFlag(name, not getFlag(name))
	end
	
	
	/** \brief List of set flags as \ref Array of \ref String. */
	func Array getSetFlags()
		var Array flags = Array.new()
		pFlags.forEach(block String name, bool flagged
			if flagged
				flags.add(name)
			end
		end)
		return flags
	end
	
	
	/**
	 * \brief Get behavior in game app or null if absent.
	 * 
	 * Use this method to check if \ref BaseGameApp contains behavior of type \ref GABehaviorFlags.
	 */
	static func GABehaviorFlags getBehaviorInApp()
		return BaseGameApp.getApp().findBehavior(block GABehaviorFlags each
			return true
		end) cast GABehaviorFlags
	end
end
