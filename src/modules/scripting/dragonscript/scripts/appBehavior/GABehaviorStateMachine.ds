namespace Dragengine
pin Dragengine.Utils
pin Dragengine.StateMachineSystem
pin Dragengine.Gui
pin Dragengine.Gui.Events
pin Dragengine.Scenery
pin Dragengine.CameraDirectors
pin Dragengine.Preloading

/**
 * \brief Game app behavior adding state machine support.
 * \version 1.35
 * 
 * The state machine to run is loaded from \ref BaseGameApp#getConfiguration() using string key
 * "appBehavior/stateMachine/path" or "appBehavior/stateMachine(id)/path". To enable debug logging
 * set string key "appBehavior/stateMachine/debug" or "appBehavior/stateMachine(id)/debug".
 * 
 * Example configuration file:
 * \code{.xml}
 * <parameterTree>
 *     <!-- other game configurations -->
 *     
 *     <!-- define state machine to load and run -->
 *     <string path='appBehavior/stateMachine/path'>/content/statemachines/game.desm</string>
 *     
 *     <!-- enable debug logging for the state machine -->
 *     <string path="appBehavior/stateMachine/debug">SM-Game</string>
 * </parameterTree>
 * \endcode
 */
class GABehaviorStateMachine extends DefaultGABehavior
	/** \brief Action "engine.update". */
	private class SMAEngineUpdate implements SMAction
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func void runAction(SMContext context, Dictionary parameters)
			var Object value
			
			if parameters.has("resetTimers")
				Engine.resetTimers()
			end
			
			value = parameters.getAt("restart", null)
			if value != null
				Engine.restart(value cast String)
			end
			
			value = parameters.getAt("log", null)
			if value != null
				Engine.log(value cast String)
			end
			
			if parameters.has("quit")
				Engine.quit()
			end
		end
	end
	
	/** \brief Condition "engine.check". */
	private class SMCEngineCheck implements SMCondition
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func bool evaluateCondition(SMContext context, Dictionary parameters)
			var bool result = true
			
			var Object value = parameters.getAt("engine.appActive", null)
			if value != null
				result &= Engine.getAppActive() == value.equals("true")
			end
			
			value = parameters.getAt("engine.editMode", null)
			if value != null
				result &= Engine.getEditMode() == value.equals("true")
			end
			
			value = parameters.getAt("engine.supportsService", null)
			if value != null
				result &= Engine.getSupportedServices().has(value cast String)
			end
			
			value = parameters.getAt("engine.supportsService.not", null)
			if value != null
				result &= not Engine.getSupportedServices().has(value cast String)
			end
			
			return result
		end
	end
	
	/** \brief Action "app.update". */
	private class SMAAppUpdate implements SMAction
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func void runAction(SMContext context, Dictionary parameters)
			var BaseGameApp app = BaseGameApp.getApp()
			var Object value
			
			value = parameters.getAt("inputProcessor", null)
			if value != null
				if value.equals("desktop")
					app.setInputProcessorDesktop()
					
				elif value.equals("bindings")
					app.setInputProcessorBindings()
					
				elif value.equals("none")
					app.setInputProcessorNothing()
				end
			end
			
			value = parameters.getAt("desktop.guiTheme", null)
			if value != null
				app.desktopLoadGuiTheme(value cast String)
			end
			
			if parameters.has("settings.save")
				app.saveSettings()
			end
			if parameters.has("bindings.save")
				app.saveBindings()
			end
			if parameters.has("loadGameWorld.cancel")
				app.cancelLoadGameWorld()
			end
			if parameters.has("loadGameWorld.finish")
				app.finishLoadGameWorld()
			end
		end
	end
	
	/** \brief Condition "app.check". */
	private class SMCAppCheck implements SMCondition
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func bool evaluateCondition(SMContext context, Dictionary parameters)
			var BaseGameApp app = BaseGameApp.getApp()
			var bool result = true
			
			var Object value = parameters.getAt("app.config", null)
			if value != null
				var Object cvalue = app.getConfiguration().getAt(value cast String, null)
				if cvalue castable bool
					cvalue = cvalue cast bool if "true" else "false"
				end
				
				value = parameters.getAt("app.config.equal", null)
				if value != null
					result &= cvalue.equals(value)
				end
				
				value = parameters.getAt("app.config.notEqual", null)
				if value != null
					result &= not cvalue.equals(value)
				end
				
				value = parameters.getAt("app.config.less", null)
				if value != null
					result &= cvalue.toString().toInt() < (value cast String).toInt()
				end
				
				value = parameters.getAt("app.config.lessOrEqual", null)
				if value != null
					result &= cvalue.toString().toInt() <= (value cast String).toInt()
				end
				
				value = parameters.getAt("app.config.greater", null)
				if value != null
					result &= cvalue.toString().toInt() > (value cast String).toInt()
				end
				
				value = parameters.getAt("app.config.greaterOrEqual", null)
				if value != null
					result &= cvalue.toString().toInt() >= (value cast String).toInt()
				end
			end
			
			value = parameters.getAt("app.setting", null)
			if value != null
				var Object cvalue = app.getSettings().getAt(value cast String, null)
				if cvalue castable bool
					cvalue = cvalue cast bool if "true" else "false"
				end
				
				value = parameters.getAt("app.setting.equal", null)
				if value != null
					result &= cvalue.equals(value)
				end
				
				value = parameters.getAt("app.setting.notEqual", null)
				if value != null
					result &= not cvalue.equals(value)
				end
				
				value = parameters.getAt("app.setting.less", null)
				if value != null
					result &= cvalue.toString().toInt() < (value cast String).toInt()
				end
				
				value = parameters.getAt("app.setting.lessOrEqual", null)
				if value != null
					result &= cvalue.toString().toInt() <= (value cast String).toInt()
				end
				
				value = parameters.getAt("app.setting.greater", null)
				if value != null
					result &= cvalue.toString().toInt() > (value cast String).toInt()
				end
				
				value = parameters.getAt("app.setting.greaterOrEqual", null)
				if value != null
					result &= cvalue.toString().toInt() >= (value cast String).toInt()
				end
			end
			
			value = parameters.getAt("services.initialized", null)
			if value != null
				result &= (app.getBaseGameServices().getInitializeServiceCount() == 0) == value.equals("true")
			end
			
			return result
		end
	end
	
	/** \brief Action "windowLogo.update". */
	private class SMAWindowLogoUpdate implements SMAction
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func void runAction(SMContext context, Dictionary parameters)
			var BaseGameApp app = BaseGameApp.getApp()
			var Object value
			
			value = parameters.getAt("show", null)
			if value != null
				var String eventName = parameters.getAt("event") cast String
				var ActionListener action = BlockActionListener.new(block ActionEvent event
					pInstance.runEvent(eventName)
				end)
				
				if value.equals("dragengine")
					WindowLogo.showDragengineLogo(app.getDesktop(), action)
					
				elif value.equals("image")
					var Image image = Image.new(parameters.getAt("image") cast String)
					var Sound sound
					
					value = parameters.getAt("sound", null)
					if value != null
						sound = Sound.new(value cast String)
					end
					
					WindowLogo.showImageLogo(app.getDesktop(), image, sound, action)
					
				elif value.equals("video")
					var Video video = Video.new(parameters.getAt("video") cast String)
					WindowLogo.showVideoLogo(app.getDesktop(), video, action)
				end
			end
		end
	end
	
	/** \brief Action "windowGameWorld.set". */
	private class SMAWindowGameWorldSet implements SMAction
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func void runAction(SMContext context, Dictionary parameters)
			var WindowGameWorld window = BaseGameApp.getApp().getWindowGameWorld()
			var Object value
			
			value = parameters.getAt("visible", null)
			if value != null
				window.setVisible(value.equals("true"))
			end
			
			value = parameters.getAt("cameraDirector", null)
			if value != null
				if value.equals("playerControlledActor")
					runCameraDirectorPlayerControlledActor(window, parameters)
				end
			end
		end
		
		func void runCameraDirectorPlayerControlledActor(WindowGameWorld window, Dictionary parameters)
			var PlayerControlledActorCameraDirector director = PlayerControlledActorCameraDirector.new()
			var CodecPropertyString codec = ElementClass.getSharedCodecPropertyString()
			
			var Object value = parameters.getAt("cameraDirector.loadCamera", null)
			if value != null
				BehaviorElementClass.sharedFactoryHelper.defaultLoaders().\
					getCamera().loadFromFile(value cast String, director)
			end
			
			value = parameters.getAt("cameraDirector.pivot", null)
			if value != null
				director.setPivot(codec.decodeDVector(value cast String))
			end
			
			value = parameters.getAt("cameraDirector.pivot.aboveGround", null)
			if value != null
				director.setPivotAboveGround((value cast String).toFloat())
			end
			
			value = parameters.getAt("cameraDirector.localMatrix.position", null)
			var Object value2 = parameters.getAt("cameraDirector.localMatrix.rotation", null)
			if value != null or value2 != null
				director.setLocalMatrix(\
					value != null if codec.decodeVector(value cast String) else Vector.new(),\
					value2 != null if codec.decodeVector(value2 cast String) else Vector.new())
			end
			
			value = parameters.getAt("cameraDirector.azimuth", null)
			if value != null
				director.setAzimuth((value cast String).toFloat())
			end
			
			value = parameters.getAt("cameraDirector.azimuth.lock", null)
			if value != null
				director.setLockAzimuth(value.equals("true"))
			end
			
			value = parameters.getAt("cameraDirector.elevation", null)
			if value != null
				director.setElevation((value cast String).toFloat())
			end
			
			value = parameters.getAt("cameraDirector.elevation.lock", null)
			if value != null
				director.setLockElevation(value.equals("true"))
			end
			
			value = parameters.getAt("cameraDirector.distance", null)
			if value != null
				director.setDistance((value cast String).toFloat())
			end
			
			value = parameters.getAt("cameraDirector.useOrientation", null)
			if value != null
				director.setUseOrientation(value.equals("true"))
			end
			
			value = parameters.getAt("cameraDirector.bone", null)
			if value != null
				director.setBone(value cast String)
			end
			
			window.setCameraDirector(director)
		end
	end
	
	/** \brief Game world loaders sendings events to state machine. */
	class GameWorldLoader extends WindowGameWorld.Loader
		var GABehaviorStateMachine pInstance
		
		func new() this(GABehaviorStateMachine.getBehaviorInApp(), BaseGameApp.getApp().getWindowGameWorld())
		end
		
		func new(GABehaviorStateMachine instance, WindowGameWorld window) super(window)
			pInstance = instance
		end
		
		func void dispose()
			super.dispose()
			pInstance = null
		end
		
		func void onLoadWorldFinished()
			super.onLoadWorldFinished()
			pInstance.runEvent("windowGameWorld.loadWorld.finished")
		end
		
		func void onLoadWorldFailed()
			super.onLoadWorldFailed()
			pInstance.runEvent("windowGameWorld.loadWorld.failed")
		end
	end
	
	/** \brief Action "windowGameWorld.update". */
	private class SMAWindowGameWorldUpdate implements SMAction
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func void runAction(SMContext context, Dictionary parameters)
			var BaseGameApp app = BaseGameApp.getApp()
			var WindowGameWorld window = app.getWindowGameWorld()
			var Object value
			
			value = parameters.getAt("runEvent", null)
			if value != null
				var GameWorld gameWorld = window.getGameWorld()
				if gameWorld != null
					gameWorld.getBehaviorBTSM().runSMEvent(value cast String)
				end
			end
			
			if parameters.has("clearWorld")
				window.setGameWorld(null)
			end
			
			value = parameters.getAt("loadWorld", null)
			if value != null
				var GameWorldLoader gwl = GameWorldLoader.new(pInstance, window)
				gwl.setPathWorld(value cast String)
				
				value = parameters.getAt("loadWorld.enableNetworking", null)
				if value != null
					gwl.setEnableNetworking(value.equals("true"))
				end
				
				value = parameters.getAt("loadWorld.ignorePersistableElements", null)
				if value != null
					gwl.setIgnorePersistableElements(value.equals("true"))
				end
				
				app.startLoadGameWorld(gwl)
			end
			
			value = parameters.getAt("addBehavior", null)
			if value != null
				var GameWorld gameWorld = window.getGameWorld()
				if gameWorld != null
					var GWBehaviorFactory factory = BaseGameApp.getApp().\
						getGWBehaviorFactories().getWithId(value cast String)
					if factory == null
						throw EInvalidParam.new("GWBehaviorFactory not found: " + value)
					end
					
					factory.addBehavior(gameWorld, parameters.getAt("addBehavior.id", "") cast String)
				end
			end
			
			value = parameters.getAt("createElement", null)
			if value != null
				var GameWorld gameWorld = window.getGameWorld()
				if gameWorld != null
					var BehaviorFactoryHelper bfh = BehaviorElementClass.sharedFactoryHelper
					var StubElement stub = StubElement.new(bfh.defaultElementClassList().\
						getNamed(value cast String), bfh.defaultIDGenerator().nextID())
					
					var Element element
					try
						element = stub.createElement()
						gameWorld.getSpawnPoints().getNamed(parameters.getAt(\
							"createElement.spawn") cast String).spawn(gameWorld, element)
						
					catch Exception e
						if element != null
							element.safeDispose()
						end
						throw
					end
				end
			end
		end
	end
	
	/** \brief Condition "windowGameWorld.check". */
	private class SMCWindowGameWorldCheck implements SMCondition
		var GABehaviorStateMachine pInstance
		
		func new(GABehaviorStateMachine instance)
			pInstance = instance
		end
		
		func bool evaluateCondition(SMContext context, Dictionary parameters)
			var WindowGameWorld window = BaseGameApp.getApp().getWindowGameWorld()
			var bool result = true
			
			var Object value = parameters.getAt("visible", null)
			if value != null
				result &= window.getVisible() == value.equals("true")
			end
			
			return result
		end
	end
	
	
	var String pPath
	var StateMachine pStateMachine
	var SMContext pContext
	var bool pServicesInitializedEventPending
	
	
	/** \brief Create behavior with empty identifier. */
	func new() this("")
		pServicesInitializedEventPending = true
	end
	
	/** \brief Create behavior. */
	func new(String id) this(id, null)
	end
	
	/** \brief Create behavior with path. */
	func new(String id, String path) super(id)
		if id == null
			throw ENullPointer.new("id")
		end
		pPath = path
	end
	
	
	/** \brief State machine path or null. */
	func String getPath()
		return pPath
	end
	
	/** \brief Set state machine path or null. */
	func void setPath(String path)
		pPath = path
	end
	
	/** \brief State machine or null if not loaded. */
	func StateMachine getStateMachine()
		return pStateMachine
	end
	
	/** \brief Context. */
	func SMContext getContext()
		return pContext
	end
	
	
	/** \brief Run event on state machine. */
	func void runEvent(String event)
		pContext.runEvent(event)
	end
	
	/** \brief Run event with parameter on state machine. */
	func void runEvent(String event, Object parameter)
		pContext.runEvent(event, parameter)
	end
	
	/** \brief Reset state machine to initial state. */
	protected func void reset()
		pContext.reset()
	end
	
	/** \brief Set action to state machine. */
	func void setAction(String name, SMAction action)
		pContext.setAction(name, action)
	end
	
	/**
	 * \brief Set action to state machine using block.
	 * 
	 * Block receives arguments \ref SMContext context and \ref Dictionary parameters.
	 */
	func void setAction(String name, Block actionBlock)
		pContext.setAction(name, actionBlock)
	end
	
	/** \brief Set condition to state machine. */
	func void setCondition(String name, SMCondition condition)
		pContext.setCondition(name, condition)
	end
	
	/**
	 * \brief Set condition to state machine using block.
	 * 
	 * Block receives arguments \ref SMContext context and \ref Dictionary parameters and
	 * returns \ref bool.
	 */
	func void setCondition(String name, Block conditionBlock)
		pContext.setCondition(name, conditionBlock)
	end
	
	
	func void initGame()
		var String basePath = getID().empty() if "appBehavior/stateMachine/"\
			else "appBehavior/stateMachine(" + getID() + ")/"
		
		var BaseGameApp app = BaseGameApp.getApp()
		var ParameterTree config = app.getConfiguration()
		var String path = config.getStringAt(basePath + "path", pPath)
		if path != null and not path.empty()
			pStateMachine = loadStateMachine(path)
		end
		if pStateMachine == null
			pStateMachine = StateMachine.newEmpty()
		end
		
		pContext = createContext(pStateMachine)
		pContext.setConsole(app.getConsole())
		
		var String debug = config.getStringAt(basePath + "debug", null)
		if debug != null and not debug.empty()
			pContext.setLoggingName(debug)
			pContext.setLogTransitions(true)
			pContext.setLogStateChanges(true)
			pContext.setLogActions(true)
		end
		
		pContext.setAction("engine.update", SMAEngineUpdate.new(this))
		pContext.setCondition("engine.check", SMCEngineCheck.new(this))
		
		pContext.setAction("app.update", SMAAppUpdate.new(this))
		pContext.setCondition("app.check", SMCAppCheck.new(this))
		
		pContext.setAction("windowLogo.update", SMAWindowLogoUpdate.new(this))
		
		pContext.setAction("windowGameWorld.set", SMAWindowGameWorldSet.new(this))
		pContext.setAction("windowGameWorld.update", SMAWindowGameWorldUpdate.new(this))
		pContext.setCondition("windowGameWorld.check", SMCWindowGameWorldCheck.new(this))
	end
	
	func void postInitGame()
		runEvent("initGame")
	end
	
	func void cleanUp()
		pContext = null
	end
	
	func void onFrameUpdate(float elapsed)
		if pServicesInitializedEventPending\
		and BaseGameApp.getApp().getBaseGameServices().getInitializeServiceCount() == 0
			pServicesInitializedEventPending = false
			runEvent("servicesInitialized")
		end
		
		runEvent("update", elapsed)
	end
	
	func void onAppActivate()
		runEvent(Engine.getAppActive() if "appActivated" else "appDeactivated")
	end
	
	
	/** \brief Load state machine. */
	protected func StateMachine loadStateMachine(String path)
		return BaseGameApp.getApp().getLoaders().getStateMachine().loadFromFile(path)
	end
	
	/** \brief Create context. */
	protected func SMContext createContext(StateMachine stateMachine)
		return SMContext.new(stateMachine)
	end
	
	
	/**
	 * \brief Get behavior in game app or null if absent.
	 * 
	 * Use this method to check if \ref BaseGameApp contains behavior of type \ref GABehaviorStateMachine.
	 */
	static func GABehaviorStateMachine getBehaviorInApp()
		return BaseGameApp.getApp().findBehavior(block GABehaviorStateMachine each
			return true
		end) cast GABehaviorStateMachine
	end
	
	/**
	 * \brief Get behavior in game app with identifier or null if absent.
	 * 
	 * Use this method to check if \ref BaseGameApp contains behavior of type \ref GABehaviorStateMachine.
	 */
	static func GABehaviorStateMachine getBehaviorInApp(String id)
		return BaseGameApp.getApp().findBehavior(block GABehaviorStateMachine each
			return each.getID().equals(id)
		end) cast GABehaviorStateMachine
	end
end
