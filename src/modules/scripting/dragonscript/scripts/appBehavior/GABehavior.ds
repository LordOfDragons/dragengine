namespace Dragengine

/**
 * \brief GameApp Behavior instance interface providing the actual game app behavior.
 * \version 1.35
 */
interface GABehavior
	/**
	 * \brief Initialize game.
	 * 
	 * Called by \ref BaseGameApp#initGame().
	 */
	func void initGame()
	
	/**
	 * \brief Post initialize game.
	 * 
	 * Called by \ref BaseGameApp#initGame() after all behaviors have been initialized.
	 */
	func void postInitGame()
	
	/**
	 * \brief Clean up game.
	 * 
	 * Called by \ref BaseGameApp#cleanUp().
	 */
	func void cleanUp()
	
	/**
	 * \brief Frame update.
	 * 
	 * Called by \ref BaseGameApp#onFrameUpdate(float).
	 */
	func void onFrameUpdate(float elapsed)
	
	/**
	 * \brief Application has received or lost focus.
	 * 
	 * Called by \ref BaseGameApp#onAppActivate().
	 */
	func void onAppActivate()
end
