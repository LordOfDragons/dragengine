namespace Dragengine
pin Dragengine.Utils
pin Dragengine.BehaviorTreeSystem
pin Dragengine.Gui
pin Dragengine.Gui.MainMenus.Interactive
pin Dragengine.Scenery
pin Dragengine.Gui.Events

/**
 * \brief Game app behavior adding \ref InteractiveMainMenu to desktop.
 * \version 1.35
 */
class GABehaviorInteractiveMainMenu extends DefaultGABehavior
	/** \brief Action "interactiveMainMenu.set". */
	private class BTSMSet extends BTSMActionCondition
		var GABehaviorInteractiveMainMenu pInstance
		
		func new(GABehaviorInteractiveMainMenu instance)
			pInstance = instance
		end
		
		func BTResult runActionShared(Object context, Dictionary parameters)
			var Object value = parameters.getAt("fadeInTime", null)
			if value != null
				pInstance.getInteractiveMainMenu().setMenuFadeInTime((value cast String).toFloat())
			end
			
			value = parameters.getAt("mainCameraSpot", null)
			if value != null
				pInstance.getInteractiveMainMenu().setMainCameraSpot(value cast String)
			end
			
			value = parameters.getAt("visible", null)
			if value != null
				pInstance.getInteractiveMainMenu().setVisible(value.equals("true"))
			end
			
			return BTResult.success
		end
	end
	
	/** \brief Action "interactiveMainMenu.update". */
	private class SMAEngineUpdate extends BTSMActionCondition
		var GABehaviorInteractiveMainMenu pInstance
		
		func new(GABehaviorInteractiveMainMenu instance)
			pInstance = instance
		end
		
		func BTResult runActionShared(Object context, Dictionary parameters)
			var Object value = parameters.getAt("activateHotSpot.action", null)
			if value != null
				var IMMBehaviorHotSpot.Instance hotSpot =\
					pInstance.getInteractiveMainMenu().getHotSpotWithAction(value cast String)
				if hotSpot != null
					pInstance.getInteractiveMainMenu().activateHotSpot(hotSpot)
				end
			end
			
			value = parameters.getAt("activeHotSpot.action", null)
			if value != null
				var IMMBehaviorHotSpot.Instance hotSpot =\
					pInstance.getInteractiveMainMenu().getHotSpotWithAction(value cast String)
				if hotSpot != null
					pInstance.getInteractiveMainMenu().setActiveHotSpot(hotSpot)
				end
			end
			
			value = parameters.getAt("loadWorld", null)
			if value != null
				pInstance.getInteractiveMainMenu().loadWorld(value cast String)
			end
			
			if parameters.has("deactivateHotSpot")
				pInstance.getInteractiveMainMenu().deactivateHotSpot()
			end
			if parameters.has("reset")
				pInstance.getInteractiveMainMenu().reset()
			end
			
			value = parameters.getAt("pause", null)
			if value != null
				if value.equals("true")
					pInstance.getInteractiveMainMenu().pause()
					
				else
					pInstance.getInteractiveMainMenu().resume()
				end
			end
			
			return BTResult.success
		end
	end
	
	/** \brief Condition "interactiveMainMenu.check". */
	private class SMCCheck extends BTSMCondition
		var GABehaviorInteractiveMainMenu pInstance
		
		func new(GABehaviorInteractiveMainMenu instance) super(instance.getPrefix())
			pInstance = instance
		end
		
		func bool evaluateConditionShared(String prefix, Object context, Dictionary parameters)
			var bool result = true
			
			var Object value = parameters.getAt(prefix + "visible", null)
			if value != null
				result &= pInstance.getInteractiveMainMenu().getVisible() == value.equals("true")
			end
			
			value = parameters.getAt(prefix + "ready", null)
			if value != null
				result &= pInstance.getInteractiveMainMenu().isReady() == value.equals("true")
			end
			
			value = parameters.getAt(prefix + "canLoadWorld", null)
			if value != null
				result &= (pInstance.getInteractiveMainMenu().getState()\
					== InteractiveMainMenu.State.constructed) == value.equals("true")
			end
			
			return result
		end
	end
	
	private class ActionRunEvent implements ActionListener
		var GABehaviorInteractiveMainMenu pInstance
		var String pEvent
		
		func new(GABehaviorInteractiveMainMenu instance, String event)
			pInstance = instance
			pEvent = event
		end
		
		func void onAction(ActionEvent event)
			pInstance.getBTSM().runEvent(pInstance.getPrefix(), pEvent, pInstance)
		end
	end
	
	
	var GAComposeBTSM pBTSMs
	var InteractiveMainMenu pWindow
	var InteractiveMainMenu.State pLastState
	var String pPrefix
	var Dictionary pActions
	
	
	/** \brief Create behavior. */
	func new()
		pPrefix = "interactiveMainMenu."
		pActions = Dictionary.new()
	end
	
	
	/** \brief Prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	/** \brief Composable component for state machines. */
	func GAComposeBTSM getBTSM()
		return pBTSMs
	end
	
	/** \brief Interactive main menu or null. */
	func InteractiveMainMenu getInteractiveMainMenu()
		return pWindow
	end
	
	
	func void initGame()
		var BaseGameApp app = BaseGameApp.getApp()
		pWindow = InteractiveMainMenu.new(app.getConsole())
		app.getDesktop().addWindow(pWindow)
		pLastState = pWindow.getState()
		
		pBTSMs = GAComposeBTSM.new()
		if pBTSMs.hasAny()
			pBTSMs.addAllAction(pPrefix, "set", BTSMSet.new(this))
			pBTSMs.addAllAction(pPrefix, "update", SMAEngineUpdate.new(this))
			pBTSMs.addAllCondition(pPrefix, "check", SMCCheck.new(this))
		end
	end
	
	func void cleanUp()
		pBTSMs = null
		if pWindow != null
			pWindow.safeDispose()
			pWindow = null
		end
		pActions.removeAll()
	end
	
	func void onFrameUpdate(float elapsed)
		var InteractiveMainMenu.State state = pWindow.getState()
		if state == pLastState
			return
		end
		
		if pLastState == InteractiveMainMenu.State.loadingWorld
			pLastState = state
			
			pActions.forEachKey(block String each
				pWindow.setActionAt(each, null)
			end)
			pActions.removeAll()
			
			if state == InteractiveMainMenu.State.constructed
				pBTSMs.runEvent(pPrefix, "loadWorld.failed", this)
				
			else
				pWindow.getWorld().forEachElement(block Element each
					if each castable BehaviorElement
						var IMMBehaviorHotSpot.Instance hotSpot =\
							IMMBehaviorHotSpot.getInstanceIn(each cast BehaviorElement)
						if hotSpot != null
							var String action = hotSpot.getAction()
							if action != null
								pWindow.setActionAt(action, ActionRunEvent.new(this, "action:" + action))
							end
						end
					end
				end)
				
				pBTSMs.runEvent(pPrefix, "loadWorld.finished", this)
			end
			
		else
			pLastState = state
		end
	end
	
	
	/**
	 * \brief Get behavior in game app or null if absent.
	 * 
	 * Use this method to check if \ref BaseGameApp contains behavior of type \ref GABehaviorInteractiveMainMenu.
	 */
	static func GABehaviorInteractiveMainMenu getBehaviorInApp()
		return BaseGameApp.getApp().findBehavior(block GABehaviorInteractiveMainMenu each
			return true
		end) cast GABehaviorInteractiveMainMenu
	end
end
