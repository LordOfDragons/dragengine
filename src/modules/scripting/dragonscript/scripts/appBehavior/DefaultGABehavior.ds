namespace Dragengine
pin Dragengine.Commands

/**
 * \brief Default implementation of \ref GABehavior.
 * \version 1.35
 * 
 * App behaviors are created during \ref BaseGameApp#initGame() call after the majority of
 * BaseGameApp class members have been created and initialized with some exceptions:
 * - Create and add element classes (before \ref #initGame())
 * - Loading bindings (before \ref #initGame())
 * - Load XML element classes (before \ref #postInitGame())
 * 
 * These actions are performed as outlined. All other data already initialized before app
 * behaviors are created should be modified during app behavior construction time.
 */
class DefaultGABehavior implements GABehavior
	var String pID
	
	
	/** \brief Create default behavior with empty identifier. */
	func new() this("")
	end
	
	/** \brief Create default behavior. */
	func new(String id)
		if id == null
			throw ENullPointer.new("id")
		end
		
		pID = id
	end
	
	
	/** \brief Identifier. */
	func String getID()
		return pID
	end
	
	
	func void initGame()
	end
	
	func void postInitGame()
	end
	
	func void cleanUp()
	end
	
	func void onFrameUpdate(float elapsed)
	end
	
	func void onAppActivate()
	end
end
