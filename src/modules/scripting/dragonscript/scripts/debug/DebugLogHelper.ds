namespace Dragengine.Debugging
pin Dragengine.Scenery

/**
 * \brief Helper class to simplify logging of complex functions.
 * \version 1.35
 * 
 * To use create log helper. During the run of the function add values as they are calculated.
 * Upon reaching important locations, like early exits or error conditions, log a message and
 * all values collected so far are added to the message.
 */
class DebugLogHelper
	var Array pValues
	
	
	/** \brief Create log helper. */
	func new()
		pValues = Array.new()
	end
	
	
	/** \brief Add or replace value. */
	func void addValue(String name, Object value)
		var int index = pValues.indexOf(name + "=")
		if index == -1
			pValues.add(name + "=" + value)
			
		else
			pValues.setAt(index, name + "=" + value)
		end
	end
	
	
	/** \brief Log message with all collected values. */
	func void log(String className, String functionName, String message)
		BaseGameApp.getApp().getConsole().addMessage("{}.{}: {} {}".format(\
			Array.newWith(className, functionName, message, pValues)))
	end
	
	/** \brief Log message with all collected values. */
	func void log(Element element, String className, String functionName, String message)
		element.log("{}.{}: {} {}".format(Array.newWith(className, functionName, message, pValues)))
	end
end
