namespace Dragengine.Scenery
pin Dragengine.Gui
pin Dragengine.Scenery
pin Dragengine.Preloading


/**
 * \brief Spawn point for actors and props.
 * 
 * Spawn points have a unique name and are added to the SpawnPointList of a GameWorld.
 */
class SpawnPoint
	var String pName
	var DVector pPosition
	var Quaternion pOrientation
	
	
	/** \brief Create spawn point. */
	func new(String name)
		if name == null
			throw ENullPointer.new("name")
		end
		pName = name
	end
	
	
	/** \brief Unique name of spawn point. */
	func String getName()
		return pName
	end
	
	/** \brief Spawn position. */
	func DVector getPosition()
		return pPosition
	end
	
	/** \brief Set spawn position. */
	func void setPosition(DVector position)
		if position == null
			throw ENullPointer.new("position")
		end
		pPosition = position
	end
	
	/** \brief Spawn orientation. */
	func Quaternion getOrientation()
		return pOrientation
	end
	
	/** \brief Set spawn orientation. */
	func void setOrientation(Quaternion orientation)
		if orientation == null
			throw ENullPointer.new("orientation")
		end
		pOrientation = orientation
	end
	
	/** \brief Spawn matrix. */
	func DMatrix getMatrix()
		return DMatrix.newWorld(pPosition, pOrientation)
	end
	
	
	/**
	 * \brief Spawn element in game world at position and orientation defined in the spawn point.
	 * 
	 * If the element is spawned already in another world it teleport instead.
	 */
	func void spawn(GameWorld gameWorld, Element element)
		spawn(gameWorld, element, Vector.new(), Vector.new())
	end
	
	/**
	 * \brief Spawn element in game world at position and orientation defined in the spawn point.
	 * 
	 * The position and rotation are relative to the spawn point. If the element is already
	 * in the game world teleports the element instead.
	 */
	func void spawn(GameWorld gameWorld, Element element, Vector position, Vector rotation)
		if gameWorld == null
			throw ENullPointer.new("gameWorld")
		end
		if element == null
			throw ENullPointer.new("element")
		end
		if position == null
			throw ENullPointer.new("position")
		end
		if rotation == null
			throw ENullPointer.new("rotation")
		end
		
		var DMatrix matrix = DMatrix.newRT(DVector.new(position), DVector.new(rotation))\
			* DMatrix.newWorld(pPosition, pOrientation)
		
		if element.getGameWorld() == gameWorld
			element.setGeometry(matrix.getPosition(), matrix.toQuaternion())
			
		else
			element.removeFromGameWorldIfPresent()
			element.setGeometry(matrix.getPosition(), matrix.toQuaternion())
			gameWorld.addElement(element)
		end
	end
end
