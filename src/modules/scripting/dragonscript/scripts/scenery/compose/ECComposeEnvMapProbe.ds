namespace Dragengine.Scenery

pin Dragengine.Gui
pin Dragengine.Preloading
pin Dragengine.Utils


/**
 * \brief Composable environment map probe for element class.
 * 
 * Provides environment map probe support to element class without subclassing from a specific class.
 */
class ECComposeEnvMapProbe
	var ECPShapeList pInfluenceArea
	var ECPFloat pInfluenceBorderSize
	var ECPInteger pInfluencePriority
	var ECPShapeList pReflectionShape, pReflectionMask
	var ECPLayerMask pLayerMask
	var String pPrefix
	
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass) this(ownerClass, "envMapProbe.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix)
		var CodecPropertyString codec = ownerClass.getSharedCodecPropertyString()
		
		ownerClass.addProperty(pInfluenceArea = ECPShapeList.new(prefix + "influenceArea", codec))
		ownerClass.addProperty(pInfluenceBorderSize = ECPFloat.new(prefix + "influenceBorderSize", 0.1, 0))
		ownerClass.addProperty(pInfluencePriority = ECPInteger.new(prefix + "influencePriority", 0))
		ownerClass.addProperty(pReflectionShape = ECPShapeList.new(prefix + "reflectionShape", codec))
		ownerClass.addProperty(pReflectionMask = ECPShapeList.new(prefix + "reflectionMask", codec))
		
		ownerClass.addProperty(pLayerMask = ECPLayerMask.new(prefix + "layerMask",\
			ownerClass.getCodecPropertyString(), BaseGameApp.getApp().getWorldLayerMap(),\
			LayerMask.newWith(BaseGameApp.WorldLayerBit.envmap)))
		
		pPrefix = prefix
	end
	
	
	
	/** \brief Influence shape. */
	func ECPShapeList getInfluenceArea()
		return pInfluenceArea
	end
	
	/** \brief Influence border size. */
	func ECPFloat getInfluenceBorderSize()
		return pInfluenceBorderSize
	end
	
	/** \brief Influence priority. */
	func ECPInteger getInfluencePriority()
		return pInfluencePriority
	end
	
	/** \brief Reflection shape. */
	func ECPShapeList getReflectionShape()
		return pReflectionShape
	end
	
	/** \brief Reflection mask. */
	func ECPShapeList getReflectionMask()
		return pReflectionMask
	end
	
	
	
	/**
	 * \brief Layer mask affecting environment probes.
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskProperty()
		return pLayerMask
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func LayerMask getLayerMask()
		return pLayerMask.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func void setLayerMask(LayerMask layerMask)
		pLayerMask.setLayerMask(layerMask)
	end
	
	/**
	 * \brief Property prefix.
	 * \version 1.12
	 */
	func String getPrefix()
		return pPrefix
	end
	
	
	
	/** \brief Initialize light for element from stub. */
	func EnvMapProbe createEnvMapProbe(Element element, StubElement stub)
		var EnvMapProbe envMapProbe = EnvMapProbe.new()
		envMapProbe.setPosition(element.getPosition())
		envMapProbe.setOrientation(element.getOrientation())
		envMapProbe.setShapeListInfluence(pInfluenceArea.getShapeList(stub))
		envMapProbe.setInfluenceBorderSize(pInfluenceBorderSize.getValue(stub))
		envMapProbe.setInfluencePriority(pInfluencePriority.getValue(stub))
		envMapProbe.setShapeReflection(pReflectionShape.getShapeList(stub))
		envMapProbe.setShapeListReflectionMask(pReflectionMask.getShapeList(stub))
		envMapProbe.setLayerMask(pLayerMask.getLayerMask(stub))
		return envMapProbe
	end
end
