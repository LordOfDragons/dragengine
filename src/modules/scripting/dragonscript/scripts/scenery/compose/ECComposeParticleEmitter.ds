namespace Dragengine.Scenery

pin Dragengine.Preloading
pin Dragengine.LoadSave
pin Dragengine.Utils
pin Dragengine.TriggerSystem


/**
 * \brief Composable particle emitter for element class.
 * 
 * Provides particle emitter support to element class without subclassing from a specific class.
 * Sets the particle emitter to use by particle emitter instance.
 */
class ECComposeParticleEmitter
	var ECPParticleEmitter pParticleEmitter
	var ECPFloat pTimeScale
	var ECPFloat pWarmUpTime
	var ECPBoolean pCasting
	var LayerMask pLayerMask
	var ECPCollisionFilter pCollisionFilter
	
	var String pPrefix
	
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(BehaviorElementClass ownerClass, Loaders loaders) \
	this(ownerClass, loaders, "particleEmitter.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(BehaviorElementClass ownerClass, Loaders loaders, String prefix)
		if prefix == null
			throw EInvalidParam.new()
		end
		
		pParticleEmitter = ECPParticleEmitter.new(prefix + "path", loaders.getParticleEmitter())
		ownerClass.addProperty(pParticleEmitter)
		
		pTimeScale = ECPFloat.new(prefix + "timeScale", 1)
		ownerClass.addProperty(pTimeScale)
		
		pWarmUpTime = ECPFloat.new(prefix + "warmUpTime", 0)
		ownerClass.addProperty(pWarmUpTime)
		
		pCasting = ECPBoolean.new(prefix + "casting", true)
		ownerClass.addProperty(pCasting)
		
		pLayerMask = LayerMask.newWith(BaseGameApp.WorldLayerBit.default)
		
		var LayerMask lmCategory = LayerMask.newWith(BaseGameApp.CollisionFilterBit.particle)
		
		var LayerMask lmFilter = LayerMask.new()
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.geometry)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.dynamic)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.actor)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.forceField)
		
		pCollisionFilter = ECPCollisionFilter.new(prefix + "collisionFilter",\
			ownerClass.getCodecPropertyString(), ownerClass.sharedFactoryHelper.defaultCollisionFilterMap(),\
			CollisionFilter.new(lmCategory, lmFilter))
		ownerClass.addProperty(pCollisionFilter)
		
		pPrefix = prefix
	end
	
	
	
	/** \brief Particle emitter resource. */
	func ECPParticleEmitter getParticleEmitter()
		return pParticleEmitter
	end
	
	/** \brief Time scale for controllers advanced by time. */
	func ECPFloat getTimeScale()
		return pTimeScale
	end
	
	/** \brief Warm up time when start casting. */
	func ECPFloat getWarmUpTime()
		return pWarmUpTime
	end
	
	/** \brief Emitter is casting particles. */
	func ECPBoolean getCasting()
		return pCasting
	end
	
	/** \brief Layer mask to set (basic layer mask). */
	func LayerMask getLayerMask()
		return pLayerMask
	end
	
	/** \brief Set layer mask to set (basic layer mask). */
	func void setLayerMask(LayerMask layerMask)
		if layerMask == null
			throw EInvalidParam.new()
		end
		pLayerMask = layerMask
	end
	
	/**
	 * \brief Collision filter.
	 * \deprecated Use getCollisionFilterProperty() instead.
	 */
	func ECComposeCollisionFilter getCollisionFilter()
		return ECComposeCollisionFilter.new(pCollisionFilter)
	end
	
	/**
	 * \brief Collision filter.
	 * \version 1.35
	 */
	func ECPCollisionFilter getCollisionFilterProperty()
		return pCollisionFilter
	end
	
	/** \brief Property prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	
	
	/**
	 * \brief Create particle emitter instance for element from stub.
	 * 
	 * Creates particle emitter instance and assigns particle emitter. The particle emitter
	 * is not setEnableCasting() by default otherwise a burst of particles can be emitted
	 * although the trigger created later on evaluates to false.
	 */
	func ParticleEmitterInstance createParticleEmitterInstance(Element element, StubElement stub)
		var ParticleEmitter emitter = pParticleEmitter.getParticleEmitter()
		var String value
		
		// particle emitter resource
		value = stub.getPropertyValueFor(pParticleEmitter.getName(), "")
		if not value.empty()
			try
				emitter = pParticleEmitter.getLoader().loadFromFile(value)
				
			catch Exception e
				throw ELoadResourceFailed.new(value, element.getClass().getClassname(), e)
			end
		end
		
		if emitter == null
			return null
		end
		
		// create particle emitter instance
		var ParticleEmitterInstance instance = ParticleEmitterInstance.new()
		instance.setEmitter(emitter)
		instance.setPosition(stub.getPosition())
		instance.setOrientation(Quaternion.newFromEuler(stub.getRotation()))
		instance.setLayerMask(pLayerMask)
		instance.setCollisionFilter(pCollisionFilter.getCollisionFilter(stub))
		instance.setTimeScale(pTimeScale.getValue(stub))
		instance.setWarmUpTime(pWarmUpTime.getValue(stub))
		return instance
	end
	
	/** \brief Create casting trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerCasting(Element element, StubElement stub)
		return createTriggerCasting(element, stub, "")
	end
	
	/** \brief Create casting trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerCasting(Element element, StubElement stub, String defaultValue)
		var String value = stub.getPropertyValueFor(pPrefix + "trigger", defaultValue)
		
		if value.empty()
			return null
			
		else
			return element.getClass().getTriggerExpressionParser().stringToExpression(value)
		end
	end
end
