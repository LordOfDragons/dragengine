namespace Dragengine.Scenery
pin Dragengine.Preloading
pin Dragengine.Utils

/**
 * \brief Composable collision filter for element class.
 */
class ECComposeCollisionFilter
	var CollisionFilter pCollisionFilter
	var ECPCollisionFilter pProperty
	
	
	/** \brief Create composable element class. */
	func new()
		pCollisionFilter = CollisionFilter.new()
	end
	
	func new(CollisionFilter filter)
		pCollisionFilter = filter
	end
	
	/**
	 * \brief Create composable element class.
	 * \version 1.35
	 */
	func new(ECPCollisionFilter property)
		pProperty = property
	end
	
	
	/** \brief Collision filter. */
	func CollisionFilter getCollisionFilter()
		return pProperty != null if pProperty.getCollisionFilter() else pCollisionFilter
	end
	
	/** \brief Set collision filter. */
	func void setCollisionFilter(CollisionFilter collisionFilter)
		if pProperty != null
			pProperty.setCollisionFilter(collisionFilter)
			
		else
			pCollisionFilter = collisionFilter
		end
	end
	
	/** \brief Convience function clearing bit in collision category. */
	func void collisionCategoryClearBit(int bit)
		if pProperty != null
			pProperty.collisionCategoryClearBit(bit)
			
		else
			var LayerMask mask = pCollisionFilter.getCategory()
			mask.clearBit(bit)
			pCollisionFilter = CollisionFilter.new(mask, pCollisionFilter.getFilter())
		end
	end
	
	/** \brief Convience function setting bit in collision category. */
	func void collisionCategorySetBit(int bit)
		if pProperty != null
			pProperty.collisionCategorySetBit(bit)
			
		else
			var LayerMask mask = pCollisionFilter.getCategory()
			mask.setBit(bit)
			pCollisionFilter = CollisionFilter.new(mask, pCollisionFilter.getFilter())
		end
	end
	
	/** \brief Convience function clearing bit in collision filter. */
	func void collisionFilterClearBit(int bit)
		if pProperty != null
			pProperty.collisionFilterClearBit(bit)
			
		else
			var LayerMask mask = pCollisionFilter.getFilter()
			mask.clearBit(bit)
			pCollisionFilter = CollisionFilter.new(pCollisionFilter.getCategory(), mask)
		end
	end
	
	/** \brief Convience function setting bit in collision filter. */
	func void collisionFilterSetBit(int bit)
		if pProperty != null
			pProperty.collisionFilterSetBit(bit)
			
		else
			var LayerMask mask = pCollisionFilter.getFilter()
			mask.setBit(bit)
			pCollisionFilter = CollisionFilter.new(pCollisionFilter.getCategory(), mask)
		end
	end
end
