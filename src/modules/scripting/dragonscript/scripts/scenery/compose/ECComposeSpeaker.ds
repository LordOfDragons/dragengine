namespace Dragengine.Scenery

pin Dragengine.Gui
pin Dragengine.LoadSave
pin Dragengine.Preloading
pin Dragengine.Utils
pin Dragengine.TriggerSystem


/**
 * \brief Composable speaker for element class.
 * 
 * Provides speaker support to element class without subclassing from a specific class.
 */
class ECComposeSpeaker
	var ECPEnumeration pSpeakerType
	var ECPSound pSound
	var ECPSynthesizer pSynthesizer
	var ECPFloat pVolume, pRange, pRollOff, pDistanceOffset, pPlaySpeed
	var ECPBoolean pMuted, pLooping, pPlaying
	var ECPShapeList pShape
	var ECPLayerMask pLayerMask
	var String pPrefix
	
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, Loaders loaders) this(ownerClass, loaders, "speaker.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, Loaders loaders, String prefix)
		ownerClass.addProperty(pSpeakerType = ECPEnumeration.new(prefix + "type", SpeakerType.all(), SpeakerType.point))
		ownerClass.addProperty(pSound = ECPSound.new(prefix + "sound"))
		ownerClass.addProperty(pSynthesizer = ECPSynthesizer.new(prefix + "synthesizer", loaders.getSynthesizer()))
		ownerClass.addProperty(pVolume = ECPFloat.new(prefix + "volume", 1, 0))
		ownerClass.addProperty(pRange = ECPFloat.new(prefix + "range", 30, 0))
		ownerClass.addProperty(pRollOff = ECPFloat.new(prefix + "rollOff", 1, 0))
		ownerClass.addProperty(pDistanceOffset = ECPFloat.new(prefix + "distanceOffset", 0, 0))
		ownerClass.addProperty(pPlaySpeed = ECPFloat.new(prefix + "playSpeed", 1))
		ownerClass.addProperty(pMuted = ECPBoolean.new(prefix + "muted", false))
		ownerClass.addProperty(pLooping = ECPBoolean.new(prefix + "looping", true))
		ownerClass.addProperty(pPlaying = ECPBoolean.new(prefix + "playing", true))
		ownerClass.addProperty(pShape = ECPShapeList.new(prefix + "shape", ownerClass.getSharedCodecPropertyString()))
		
		ownerClass.addProperty(pLayerMask = ECPLayerMask.new(prefix + "layerMask",\
			ownerClass.getSharedCodecPropertyString(), BaseGameApp.getApp().getWorldLayerMap(),\
			LayerMask.newWith(BaseGameApp.WorldLayerBit.audio)))
		
		pPrefix = prefix
	end
	
	
	
	/** \brief Speaker type. */
	func ECPEnumeration getSpeakerType()
		return pSpeakerType
	end
	
	/** \brief Speaker sound. */
	func ECPSound getSound()
		return pSound
	end
	
	/** \brief Speaker synthesizer. */
	func ECPSynthesizer getSynthesizer()
		return pSynthesizer
	end
	
	/** \brief Speaker volume. */
	func ECPFloat getVolume()
		return pVolume
	end
	
	/** \brief Speaker range. */
	func ECPFloat getRange()
		return pRange
	end
	
	/** \brief Roll off. */
	func ECPFloat getRollOff()
		return pRollOff
	end
	
	/** \brief Distance offset. */
	func ECPFloat getDistanceOffset()
		return pDistanceOffset
	end
	
	/** \brief Play speed. */
	func ECPFloat getPlaySpeed()
		return pPlaySpeed
	end
	
	/** \brief Speaker is muted. */
	func ECPBoolean getMuted()
		return pMuted
	end
	
	/** \brief Speaker is looping. */
	func ECPBoolean getLooping()
		return pLooping
	end
	
	/** \brief Speaker is playing. */
	func ECPBoolean getPlaying()
		return pPlaying
	end
	
	/**
	 * \brief Layer mask.
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskProperty()
		return pLayerMask
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func LayerMask getLayerMask()
		return pLayerMask.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func void setLayerMask(LayerMask layerMask)
		pLayerMask.setLayerMask(layerMask)
	end
	
	/** \brief Property prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	/** \brief Speaker shape. */
	func ECPShapeList getShape()
		return pShape
	end
	
	
	
	/** \brief Create speaker. */
	func Speaker createSpeaker()
		var Speaker speaker = Speaker.new()
		
		speaker.setType(pSpeakerType.getEnumeration() cast SpeakerType)
		speaker.setSound(pSound.getSound())
		speaker.setVolume(pVolume.getValue())
		speaker.setRange(pRange.getValue())
		speaker.setLayerMask(pLayerMask.getLayerMask())
		speaker.setRollOff(pRollOff.getValue())
		speaker.setDistanceOffset(pDistanceOffset.getValue())
		speaker.setPlaySpeed(pPlaySpeed.getValue())
		speaker.setMuted(pMuted.getValue())
		speaker.setLooping(pLooping.getValue())
		speaker.setShape(pShape.getShapeList())
		
		var Synthesizer synthesizer = pSynthesizer.getSynthesizer()
		if synthesizer != null
			var SynthesizerInstance synthInst = SynthesizerInstance.new()
			synthInst.setSynthesizer(synthesizer)
			speaker.setSynthesizer(synthInst)
		end
		
		if pPlaying.getValue()
			speaker.play()
		end
		
		return speaker
	end
	
	/** \brief Initialize speaker for element from stub. */
	func Speaker createSpeaker(Element element, StubElement stub)
		var ElementClass eclass = element.getClass()
		var Speaker speaker = Speaker.new()
		
		speaker.setPosition(element.getPosition())
		speaker.setOrientation(element.getOrientation())
		speaker.setType(pSpeakerType.getEnumeration(stub) cast SpeakerType)
		speaker.setSound(pSound.getSound(stub, eclass))
		speaker.setVolume(pVolume.getValue(stub))
		speaker.setRange(pRange.getValue(stub))
		speaker.setLayerMask(pLayerMask.getLayerMask(stub))
		speaker.setRollOff(pRollOff.getValue(stub))
		speaker.setDistanceOffset(pDistanceOffset.getValue(stub))
		speaker.setPlaySpeed(pPlaySpeed.getValue(stub))
		speaker.setMuted(pMuted.getValue(stub))
		speaker.setLooping(pLooping.getValue(stub))
		speaker.setShape(pShape.getShapeList(stub))
		
		var Synthesizer synthesizer = pSynthesizer.getSynthesizer(stub, eclass)
		if synthesizer != null
			var SynthesizerInstance synthInst = SynthesizerInstance.new()
			synthInst.setSynthesizer(synthesizer)
			speaker.setSynthesizer(synthInst)
		end
		
		if pPlaying.getValue(stub)
			speaker.play()
		end
		
		return speaker
	end
	
	/** \brief Create muted speaker trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerMuted(Element element, StubElement stub)
		return createTriggerMuted(element, stub, "")
	end
	
	/** \brief Create muted speaker trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerMuted(Element element, StubElement stub, String defaultValue)
		var String value = stub.getPropertyValueFor(pPrefix + "trigger(muted)", defaultValue)
		
		if value.empty()
			return null
			
		else
			return element.getClass().getTriggerExpressionParser().stringToExpression(value)
		end
	end
	
	/** \brief Create playing speaker trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerPlaying(Element element, StubElement stub)
		return createTriggerPlaying(element, stub, "")
	end
	
	/** \brief Create playing speaker trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerPlaying(Element element, StubElement stub, String defaultValue)
		var String value = stub.getPropertyValueFor(pPrefix + "trigger", defaultValue)
		
		if value.empty()
			return null
			
		else
			return element.getClass().getTriggerExpressionParser().stringToExpression(value)
		end
	end
end
