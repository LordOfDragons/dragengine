namespace Dragengine.Scenery
pin Dragengine.Preloading
pin Dragengine.Utils

/**
 * \brief Composable component collider for element class.
 * 
 * Provides collider support to element class without subclassing from a specific class.
 * Element is set as owner of the created component.
 */
class ECComposeCollider
	var ECPEnumeration pPhysicsType
	var ECPVector pLocalGravity
	var ECPFloat pWeight
	var ECPBoolean pEnabled
	var ECPShapeList pShape
	var ECPRig pRig
	var ECPCollisionFilter pCollisionFilter
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use \ref ElementClass#removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass) this(ownerClass, "collider.")
	end
	
	func new(ElementClass ownerClass, String prefix)\
	this(ownerClass, prefix, BehaviorElementClass.sharedFactoryHelper.defaultCollisionFilterMap())
	end
	
	/**
	 * \brief Create composable element class.
	 * \version 1.35
	 * 
	 * Adds all properties to ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use \ref ElementClass#removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix, Dictionary collisionFilterBitMap)
		pPhysicsType = ECPEnumeration.new(prefix + "physicsType",\
			CollisionResponse.all(), CollisionResponse.none)
		ownerClass.addProperty(pPhysicsType)
		
		pLocalGravity = ECPVector.new(prefix + "localGravity", null)
		ownerClass.addProperty(pLocalGravity)
		
		pWeight = ECPFloat.new(prefix + "weight", 1, 0)
		ownerClass.addProperty(pWeight)
		
		pEnabled = ECPBoolean.new(prefix + "enabled", true)
		ownerClass.addProperty(pEnabled)
		
		pShape = ECPShapeList.new(prefix + "shape", ownerClass.getCodecPropertyString())
		ownerClass.addProperty(pShape)
		
		pRig = ECPRig.new(prefix + "rig")
		ownerClass.addProperty(pRig)
		
		pCollisionFilter = ECPCollisionFilter.new(prefix + "collisionFilter",\
			ownerClass.getCodecPropertyString(), collisionFilterBitMap, CollisionFilter.new(\
				LayerMask.newWith(BaseGameApp.CollisionFilterBit.geometry),\
				LayerMask.newWith(BaseGameApp.CollisionFilterBit.dynamic,\
					BaseGameApp.CollisionFilterBit.particle)))
		ownerClass.addProperty(pCollisionFilter)
	end
	
	
	/** \brief Physics type. */
	func ECPEnumeration getPhysicsType()
		return pPhysicsType
	end
	
	/** \brief Local gravity or \em null to use the world gravity. */
	func ECPVector getLocalGravity()
		return pLocalGravity
	end
	
	/** \brief Weight in kg. */
	func ECPFloat getWeight()
		return pWeight
	end
	
	/** \brief Enable collider. */
	func ECPBoolean getEnabled()
		return pEnabled
	end
	
	/** \brief Shape if no component is used. */
	func ECPShapeList getShape()
		return pShape
	end
	
	/** \brief Rig if no component is used. */
	func ECPRig getRig()
		return pRig
	end
	
	/**
	 * \brief Collision filter property.
	 * \version 1.35
	 */
	func ECPCollisionFilter getCollisionFilterProperty()
		return pCollisionFilter
	end
	
	
	/**
	 * \brief Collision filter.
	 * \deprecated Use getCollisionFilterProperty().getCollisionFilter() instead.
	 */
	func CollisionFilter getCollisionFilter()
		return pCollisionFilter.getCollisionFilter()
	end
	
	/**
	 * \brief Set collision filter.
	 * \deprecated Use getCollisionFilterProperty().setCollisionFilter() instead.
	 */
	func void setCollisionFilter(CollisionFilter collisionFilter)
		pCollisionFilter.setCollisionFilter(collisionFilter)
	end
	
	/**
	 * \brief Convience function clearing bit in collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategoryClearBit() instead.
	 */
	func void collisionCategoryClearBit(int bit)
		pCollisionFilter.collisionCategoryClearBit(bit)
	end
	
	/**
	 * \brief Convience function setting bit in collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategorySetBit() instead.
	 */
	func void collisionCategorySetBit(int bit)
		pCollisionFilter.collisionCategorySetBit(bit)
	end
	
	/**
	 * \brief Convience function replacing collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategorySet() instead.
	 */
	func void collisionCategoryReplace(LayerMask layerMask)
		pCollisionFilter.collisionCategorySet(layerMask)
	end
	
	/**
	 * \brief Convience function clearing bit in collision filter.
	 * \deprecated Use getCollisionFilterProperty().collisionFilterClearBit() instead.
	 */
	func void collisionFilterClearBit(int bit)
		pCollisionFilter.collisionFilterClearBit(bit)
	end
	
	/**
	 * \brief Convience function setting bit in collision filter.
	 * \deprecated Use getCollisionFilterProperty().collisionFilterSetBit() instead.
	 */
	func void collisionFilterSetBit(int bit)
		pCollisionFilter.collisionFilterSetBit(bit)
	end
	
	
	/**
	 * \brief Create collider for the element from stub.
	 * 
	 * \em element is set as owner of collider if a collider is created.
	 */
	func Collider createCollider(Element element, StubElement stub, Component component)
		// component collider requires component with rig
		if component == null or component.getRig() == null
			return null
		end
		
		// create collider component
		var ColliderComponent collider = ColliderComponent.new()
		initCollider(collider, element, stub)
		collider.setComponent(component)
		return collider
	end
	
	/**
	 * \brief Create collider for the element from stub.
	 * 
	 * \em element is set as owner of collider if a collider is created.
	 */
	func Collider createCollider(Element element, StubElement stub)
		var Rig rig = pRig.getRig(stub, element.getClass())
		
		if rig != null
			// create collider rig
			var ColliderRig collider = ColliderRig.new()
			initCollider(collider, element, stub)
			collider.setRig(rig)
			return collider
			
		else
			// create collider volume
			var ColliderVolume collider = ColliderVolume.new()
			initCollider(collider, element, stub)
			collider.setShape(pShape.getShapeList(stub))
			return collider
		end
	end
	
	/** \brief Init collider from stub. */
	protected func void initCollider(Collider collider, Element element, StubElement stub)
		collider.setResponseType(pPhysicsType.getEnumeration() cast CollisionResponse)
		collider.setCollisionFilter(pCollisionFilter.getCollisionFilter(stub))
		collider.setEnabled(pEnabled.getValue())
		collider.setMass(pWeight.getValue(stub))
		
		collider.setGeometry(element.getPosition(), element.getOrientation())
		//collider.setScaling(stub.getScaling()) // not supported yet
		
		var Vector localGravity = pLocalGravity.getVector()
		if localGravity == null
			collider.setUseLocalGravity(false)
			
		else
			collider.setGravity(localGravity)
			collider.setUseLocalGravity(true)
		end
		
		collider.setOwner(element)
	end
end
