namespace Dragengine.Scenery
pin Dragengine.Gui
pin Dragengine.Preloading
pin Dragengine.Utils
pin Dragengine.TriggerSystem

/**
 * \brief Composable force field for element class.
 * 
 * Provides force field support to element class without subclassing from a specific class.
 */
class ECComposeForceField
	var String pPrefix
	var ECPShapeList pInfluenceArea
	var ECPFloat pRadius, pExponent
	var ECPEnumeration pFieldType, pApplicationType
	var ECPVector pDirection
	var ECPFloat pForce, pFluctuationDirection, pFluctuationForce
	var ECPBoolean pEnabled
	var ECPShapeList pShape
	var ECPCollisionFilter pCollisionFilter
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass) this(ownerClass, "forceField.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix)\
	this(ownerClass, prefix, BehaviorElementClass.sharedFactoryHelper.defaultCollisionFilterMap())
	end
	
	/**
	 * \brief Create composable element class.
	 * \version 1.35
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix, Dictionary collisionFilterBitMap)
		pInfluenceArea = ECPShapeList.new(prefix + "influenceArea", \
			ownerClass.getSharedCodecPropertyString())
		ownerClass.addProperty(pInfluenceArea)
		
		pRadius = ECPFloat.new(prefix + "radius", 1, 0)
		ownerClass.addProperty(pRadius)
		
		pExponent = ECPFloat.new(prefix + "exponent", 1, 0)
		ownerClass.addProperty(pExponent)
		
		pFieldType = ECPEnumeration.new(prefix + "fieldType", \
			ForceFieldType.all(), ForceFieldType.radial)
		ownerClass.addProperty(pFieldType)
		
		pApplicationType = ECPEnumeration.new(prefix + "applicationType", \
			ForceFieldApplication.all(), ForceFieldApplication.direct)
		ownerClass.addProperty(pApplicationType)
		
		pDirection = ECPVector.new(prefix + "direction", Vector.new())
		ownerClass.addProperty(pDirection)
		
		pForce = ECPFloat.new(prefix + "force", 1)
		ownerClass.addProperty(pForce)
		
		pFluctuationDirection = ECPFloat.new(prefix + "fluctuationDirection", 0)
		ownerClass.addProperty(pFluctuationDirection)
		
		pFluctuationForce = ECPFloat.new(prefix + "fluctuationForce", 0)
		ownerClass.addProperty(pFluctuationForce)
		
		pEnabled = ECPBoolean.new(prefix + "enabled", true)
		ownerClass.addProperty(pEnabled)
		
		pShape = ECPShapeList.new(prefix + "shape", ownerClass.getSharedCodecPropertyString())
		ownerClass.addProperty(pShape)
		
		var LayerMask lmCategory = LayerMask.newWith(BaseGameApp.CollisionFilterBit.forceField)
		
		var LayerMask lmFilter = LayerMask.new()
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.geometry)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.dynamic)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.actor)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.actorAI)
		lmFilter.setBit(BaseGameApp.CollisionFilterBit.particle)
		
		pCollisionFilter = ECPCollisionFilter.new(prefix + "collisionFilter",\
			ownerClass.getCodecPropertyString(), collisionFilterBitMap,\
			CollisionFilter.new(lmCategory, lmFilter))
		ownerClass.addProperty(pCollisionFilter)
		
		pPrefix = prefix
	end
	
	
	/** \brief Influence area. */
	func ECPShapeList getInfluenceArea()
		return pInfluenceArea
	end
	
	/** \brief Falloff radius. */
	func ECPFloat getRadius()
		return pRadius
	end
	
	/** \brief Falloff exponent. */
	func ECPFloat getExponent()
		return pExponent
	end
	
	/** \brief Field type. */
	func ECPEnumeration getFieldType()
		return pFieldType
	end
	
	/** \brief Force application type. */
	func ECPEnumeration getApplicationType()
		return pApplicationType
	end
	
	/** \brief Force direction. */
	func ECPVector getDirection()
		return pDirection
	end
	
	/** \brief Force in newton. */
	func ECPFloat getForce()
		return pForce
	end
	
	/** \brief Fluctuation of direction in degrees. */
	func ECPFloat getFluctuationDirection()
		return pFluctuationDirection
	end
	
	/** \brief Fluctuation of force in newton. */
	func ECPFloat getFluctuationForce()
		return pFluctuationForce
	end
	
	/** \brief Initial force field enabled state. */
	func ECPBoolean getEnabled()
		return pEnabled
	end
	
	/** \brief Property prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	/** \brief Shape from which force originates. */
	func ECPShapeList getShape()
		return pShape
	end
	
	/**
	 * \brief Collision filter property.
	 * \version 1.35
	 */
	func ECPCollisionFilter getCollisionFilterProperty()
		return pCollisionFilter
	end
	
	
	/**
	 * \brief Collision filter.
	 * \deprecated Use getCollisionFilterProperty().getCollisionFilter() instead.
	 */
	func CollisionFilter getCollisionFilter()
		return pCollisionFilter.getCollisionFilter()
	end
	
	/**
	 * \brief Set collision filter.
	 * \deprecated Use getCollisionFilterProperty().setCollisionFilter() instead.
	 */
	func void setCollisionFilter(CollisionFilter collisionFilter)
		pCollisionFilter.setCollisionFilter(collisionFilter)
	end
	
	/**
	 * \brief Convience function clearing bit in collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategoryClearBit() instead.
	 */
	func void collisionCategoryClearBit(int bit)
		pCollisionFilter.collisionCategoryClearBit(bit)
	end
	
	/**
	 * \brief Convience function setting bit in collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategorySetBit() instead.
	 */
	func void collisionCategorySetBit(int bit)
		pCollisionFilter.collisionCategorySetBit(bit)
	end
	
	/**
	 * \brief Convience function replacing collision category.
	 * \deprecated Use getCollisionFilterProperty().collisionCategorySet() instead.
	 */
	func void collisionCategoryReplace(LayerMask layerMask)
		pCollisionFilter.collisionCategorySet(layerMask)
	end
	
	/**
	 * \brief Convience function clearing bit in collision filter.
	 * \deprecated Use getCollisionFilterProperty().collisionFilterClearBit() instead.
	 */
	func void collisionFilterClearBit(int bit)
		pCollisionFilter.collisionFilterClearBit(bit)
	end
	
	/**
	 * \brief Convience function setting bit in collision filter.
	 * \deprecated Use getCollisionFilterProperty().collisionFilterSetBit() instead.
	 */
	func void collisionFilterSetBit(int bit)
		pCollisionFilter.collisionFilterSetBit(bit)
	end
	
	
	/** \brief Initialize force field for element from stub. */
	func ForceField createForceField(Element element, StubElement stub)
		var CodecPropertyString codec = element.getClass().getCodecPropertyString()
		var ForceField forceField = ForceField.new()
		
		forceField.setPosition(element.getPosition())
		forceField.setOrientation(element.getOrientation())
		
		forceField.setInfluenceArea(pInfluenceArea.getShapeList(stub))
		forceField.setRadius(pRadius.getValue(stub))
		forceField.setExponent(pExponent.getValue(stub))
		
		forceField.setFieldType(pFieldType.getEnumeration(stub) cast ForceFieldType)
		forceField.setApplicationType(pApplicationType.getEnumeration(stub) cast ForceFieldApplication)
		forceField.setDirection(pDirection.getVector(stub, codec))
		forceField.setForce(pForce.getValue(stub))
		forceField.setFluctuationDirection(pFluctuationDirection.getValue(stub))
		forceField.setFluctuationForce(pFluctuationForce.getValue(stub))
		forceField.setShape(pShape.getShapeList(stub))
		
		forceField.setCollisionFilter(pCollisionFilter.getCollisionFilter(stub))
		forceField.setEnabled(pEnabled.getValue(stub))
		
		return forceField
	end
	
	/** \brief Create activate force field trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerEnable(Element element, StubElement stub)
		return createTriggerEnable(element, stub, "")
	end
	
	/** \brief Create activate force field trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerEnable(Element element, StubElement stub, String defaultValue)
		var String value = stub.getPropertyValueFor(pPrefix + "trigger", defaultValue)
		
		if value.empty()
			return null
			
		else
			return element.getClass().getTriggerExpressionParser().stringToExpression(value)
		end
	end
end
