namespace Dragengine.Scenery

pin Dragengine.Gui
pin Dragengine.Preloading
pin Dragengine.Utils
pin Dragengine.TriggerSystem


/**
 * \brief Composable light for element class.
 * 
 * Provides light support to element class without subclassing from a specific class.
 */
class ECComposeLight
	var ECPEnumeration pType
	var ECPColor pColor
	var ECPFloat pIntensity, pAmbientRatio, pRange, pHalfIntensityDistance
	var ECPFloat pSpotAngle, pSpotRatio, pSpotSmoothness, pSpotExponent
	var ECPShapeList pShape
	var ECPSkin pLightSkin
	var ECPEnumeration pHintMovement, pHintParameter
	var ECPInteger pHintShadowImportance
	var ECPBoolean pActivated, pCastShadows
	var ECPLayerMask pLayerMask, pLayerMaskShadow
	var String pPrefix
	
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass) this(ownerClass, "light.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix)
		ownerClass.addProperty(pType = ECPEnumeration.new(prefix + "type", LightType.all(), LightType.point))
		ownerClass.addProperty(pColor = ECPColor.new(prefix + "color", Color.white))
		ownerClass.addProperty(pIntensity = ECPFloat.new(prefix + "intensity", 1, 0))
		ownerClass.addProperty(pAmbientRatio = ECPFloat.new(prefix + "ambientRatio", 0, 0, 1))
		ownerClass.addProperty(pRange = ECPFloat.new(prefix + "range", 10, 0))
		ownerClass.addProperty(pHalfIntensityDistance = ECPFloat.new(prefix + "halfIntensityDistance", 0.1, 0, 1))
		ownerClass.addProperty(pSpotAngle = ECPFloat.new(prefix + "spotAngle", 30, 0, 179))
		ownerClass.addProperty(pSpotRatio = ECPFloat.new(prefix + "spotRatio", 1, 0))
		ownerClass.addProperty(pSpotSmoothness = ECPFloat.new(prefix + "spotSmoothness", 1, 0, 1))
		ownerClass.addProperty(pSpotExponent = ECPFloat.new(prefix + "spotExponent", 2, 0))
		ownerClass.addProperty(pShape = ECPShapeList.new(prefix + "shape", ownerClass.getSharedCodecPropertyString()))
		ownerClass.addProperty(pLightSkin = ECPSkin.new(prefix + "lightSkin"))
		ownerClass.addProperty(pHintMovement = ECPEnumeration.new(prefix + "hintMovement", \
			LightHintMovement.all(), LightHintMovement.stationary))
		ownerClass.addProperty(pHintParameter = ECPEnumeration.new(prefix + "hintParameter", \
			LightHintParameter.all(), LightHintParameter.initial))
		ownerClass.addProperty(pHintShadowImportance = ECPInteger.new(prefix + "hintShadowImportance", 100, 0, 100))
		ownerClass.addProperty(pActivated = ECPBoolean.new(prefix + "activated", true))
		ownerClass.addProperty(pCastShadows = ECPBoolean.new(prefix + "castShadows", true))
		
		var CodecPropertyString codec = ownerClass.getSharedCodecPropertyString()
		var Dictionary layerMap = BaseGameApp.getApp().getWorldLayerMap()
		var LayerMask lm = LayerMask.newWith(BaseGameApp.WorldLayerBit.default, BaseGameApp.WorldLayerBit.envmap)
		ownerClass.addProperty(pLayerMask = ECPLayerMask.new(prefix + "layerMask", codec, layerMap, lm))
		ownerClass.addProperty(pLayerMaskShadow = ECPLayerMask.new(prefix + "layerMaskShadow", codec, layerMap, lm))
		
		pPrefix = prefix
	end
	
	
	
	/** \brief Light type. */
	func ECPEnumeration getType()
		return pType
	end
	
	/** \brief Light color. */
	func ECPColor getColor()
		return pColor
	end
	
	/** \brief Light intensity. */
	func ECPFloat getIntensity()
		return pIntensity
	end
	
	/** \brief Ambient ratio. */
	func ECPFloat getAmbientRatio()
		return pAmbientRatio
	end
	
	/** \brief Light range. */
	func ECPFloat getRange()
		return pRange
	end
	
	/** \brief Half intensity distance. */
	func ECPFloat getHalfIntensityDistance()
		return pHalfIntensityDistance
	end
	
	/** \brief Outer spot Angle. */
	func ECPFloat getSpotAngle()
		return pSpotAngle
	end
	
	/** \brief Spot ratio as height divided by width. */
	func ECPFloat getSpotRatio()
		return pSpotRatio
	end
	
	/** \brief Spot smoothness. */
	func ECPFloat getSpotSmoothness()
		return pSpotSmoothness
	end
	
	/** \brief Spot exponent. */
	func ECPFloat getSpotExponent()
		return pSpotExponent
	end
	
	/** \brief Light shape. */
	func ECPShapeList getShape()
		return pShape
	end
	
	/** \brief Light skin. */
	func ECPSkin getLightSkin()
		return pLightSkin
	end
	
	/** \brief Hint movement. */
	func ECPEnumeration getHintMovement()
		return pHintMovement
	end
	
	/** \brief Hint parameter. */
	func ECPEnumeration getHintParameter()
		return pHintParameter
	end
	
	/** \brief Hint shadow importance. */
	func ECPInteger getHintShadowImportance()
		return pHintShadowImportance
	end
	
	/** \brief Initial light activated state. */
	func ECPBoolean getActivated()
		return pActivated
	end
	
	/** \brief Light is casting shadows. */
	func ECPBoolean getCastShadows()
		return pCastShadows
	end
	
	/** \brief Property prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	
	
	/**
	 * \brief Layer mask affecting lighting.
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskProperty()
		return pLayerMask
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func LayerMask getLayerMask()
		return pLayerMask.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func void setLayerMask(LayerMask layerMask)
		pLayerMask.setLayerMask(layerMask)
	end
	
	/**
	 * \brief Layer mask affecting shadow casting.
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskShadowProperty()
		return pLayerMaskShadow
	end
	
	/** \deprecated Use \ref #getLayerMaskShadowProperty() instead. */
	func LayerMask getLayerMaskShadow()
		return pLayerMaskShadow.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskShadowProperty() instead. */
	func void setLayerMaskShadow(LayerMask layerMask)
		pLayerMaskShadow.setLayerMask(layerMask)
	end
	
	
	
	/** \brief Initialize light for element from stub. */
	func Light createLight(Element element, StubElement stub)
		var CodecPropertyString codec = element.getClass().getCodecPropertyString()
		var Light light = Light.new()
		
		light.setPosition(element.getPosition())
		light.setOrientation(element.getOrientation())
		
		light.setType(pType.getEnumeration(stub) cast LightType)
		light.setColor(pColor.getColor(stub, codec))
		light.setIntensity(pIntensity.getValue(stub))
		light.setAmbientRatio(pAmbientRatio.getValue(stub))
		light.setRange(pRange.getValue(stub))
		light.setHalfIntensityDistance(pHalfIntensityDistance.getValue(stub))
		
		if light.getType() != LightType.point
			light.setSpotAngle(pSpotAngle.getValue(stub))
			light.setSpotRatio(pSpotRatio.getValue(stub))
			light.setSpotSmoothness(pSpotSmoothness.getValue(stub))
			light.setSpotExponent(pSpotExponent.getValue(stub))
		end
		
		light.setShape(pShape.getShapeList(stub))
		light.setLightSkin(pLightSkin.getSkin(stub, element.getClass()))
		light.setHintMovement(pHintMovement.getEnumeration(stub) cast LightHintMovement)
		light.setHintParameter(pHintParameter.getEnumeration(stub) cast LightHintParameter)
		light.setHintLightImportance(100)
		light.setHintShadowImportance(pHintShadowImportance.getValue(stub))
		
		light.setActivated(pActivated.getValue(stub))
		light.setCastShadows(pCastShadows.getValue(stub))
		
		light.setLayerMask(pLayerMask.getLayerMask(stub))
		light.setLayerMaskShadow(pLayerMaskShadow.getLayerMask(stub))
		
		return light
	end
	
	/** \brief Create activate light trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerActivate(Element element, StubElement stub)
		return createTriggerActivate(element, stub, "")
	end
	
	/** \brief Create activate light trigger expression from stub or \em null if not used. */
	func TSTriggerExpression createTriggerActivate(Element element, StubElement stub, String defaultValue)
		var String value = stub.getPropertyValueFor(pPrefix + "trigger", defaultValue)
		
		if value.empty()
			return null
			
		else
			return element.getClass().getTriggerExpressionParser().stringToExpression(value)
		end
	end
end
