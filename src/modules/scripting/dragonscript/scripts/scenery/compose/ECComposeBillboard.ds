namespace Dragengine.Scenery

pin Dragengine.Preloading
pin Dragengine.Utils


/**
 * \brief Composable billboard for element class.
 * 
 * Provides billboard support to element class without subclassing from a specific class.
 */
class ECComposeBillboard
	var ECPSkin pSkin
	var ECPVector pAxis
	var ECPVector2 pOffset
	var ECPBoolean pLocked
	var ECPBoolean pSpherical
	var ECPBoolean pSizeFixedToScreen
	var ECPBoolean pRenderEnvMap
	var ECPLayerMask pLayerMask, pLayerMaskRenderEnvMap
	
	var String pPrefix
	
	
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass) this(ownerClass, "billboard.")
	end
	
	/**
	 * \brief Create composable element class.
	 * 
	 * Adds all properties to \em ownerClass. If you do not want a property to be configurable
	 * using XML subclassing use ownerClass.removeProperty() to remove them.
	 */
	func new(ElementClass ownerClass, String prefix)
		if prefix == null
			throw EInvalidParam.new()
		end
		
		ownerClass.addProperty(pSkin = ECPSkin.new(prefix + "skin"))
		ownerClass.addProperty(pAxis = ECPVector.new(prefix + "axis", Vector.new(0, 1, 0)))
		ownerClass.addProperty(pOffset = ECPVector2.new(prefix + "offset", Vector2.new()))
		ownerClass.addProperty(pLocked = ECPBoolean.new(prefix + "locked", true))
		ownerClass.addProperty(pSpherical = ECPBoolean.new(prefix + "spherical", true))
		ownerClass.addProperty(pSizeFixedToScreen = ECPBoolean.new(prefix + "sizeFixedToScreen", false))
		ownerClass.addProperty(pRenderEnvMap = ECPBoolean.new(prefix + "renderEnvMap", true))
		
		var CodecPropertyString codec = ownerClass.getCodecPropertyString()
		var Dictionary layerMap = BaseGameApp.getApp().getWorldLayerMap()
		
		ownerClass.addProperty(pLayerMask = ECPLayerMask.new(\
			prefix + "layerMask", codec, layerMap,\
			LayerMask.newWith(BaseGameApp.WorldLayerBit.default)))
		
		ownerClass.addProperty(pLayerMaskRenderEnvMap = ECPLayerMask.new(\
			prefix + "layerMaskRenderEnvMap", codec, layerMap,\
			LayerMask.newWith(BaseGameApp.WorldLayerBit.envmap)))
		
		pPrefix = prefix
	end
	
	
	
	/** \brief Skin resource. */
	func ECPSkin getSkin()
		return pSkin
	end
	
	/** \brief Billboard axis. */
	func ECPVector getAxis()
		return pAxis
	end
	
	/** \brief Billboard offset. */
	func ECPVector2 getOffset()
		return pOffset
	end
	
	/** \brief Billboard is locked. */
	func ECPBoolean getLocked()
		return pLocked
	end
	
	/** \brief Billboard is spherical. */
	func ECPBoolean getSpherical()
		return pSpherical
	end
	
	/** \brief Billboard size is fixed to the screen size. */
	func ECPBoolean getSizeFixedToScreen()
		return pSizeFixedToScreen
	end
	
	/** \brief Render prop in environment maps. */
	func ECPBoolean getRenderEnvMap()
		return pRenderEnvMap
	end
	
	/**
	 * \brief Layer mask to set (basic layer mask).
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskProperty()
		return pLayerMask
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func LayerMask getLayerMask()
		return pLayerMask.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskProperty() instead. */
	func void setLayerMask(LayerMask layerMask)
		pLayerMask.setLayerMask(layerMask)
	end
	
	/**
	 * \brief Layer mask to set if render environment map is true.
	 * \version 1.35
	 */
	func ECPLayerMask getLayerMaskRenderEnvMapProperty()
		return pLayerMaskRenderEnvMap
	end
	
	/** \deprecated Use \ref #getLayerMaskRenderEnvMapProperty() instead. */
	func LayerMask getLayerMaskRenderEnvMap()
		return pLayerMaskRenderEnvMap.getLayerMask()
	end
	
	/** \deprecated Use \ref #getLayerMaskRenderEnvMapProperty() instead. */
	func void setLayerMaskRenderEnvMap(LayerMask layerMask)
		pLayerMaskRenderEnvMap.setLayerMask(layerMask)
	end
	
	/** \brief Property prefix. */
	func String getPrefix()
		return pPrefix
	end
	
	
	
	/** \brief Initialize billboard for element from stub. */
	func Billboard createBillboard(Element element, StubElement stub)
		var ElementClass eclass = element.getClass()
		var CodecPropertyString codec = element.getClass().getCodecPropertyString()
		var Billboard billboard = Billboard.new()
		
		billboard.setSkin(pSkin.getSkin(stub, eclass))
		billboard.setPosition(element.getPosition())
		billboard.setSize(Vector2.new(element.getScaling().getX(), element.getScaling().getY()))
		billboard.setOffset(pOffset.getVector2(stub, codec))
		billboard.setAxis(pAxis.getVector(stub, codec))
		billboard.setLocked(pLocked.getValue(stub))
		billboard.setSpherical(pSpherical.getValue(stub))
		billboard.setSizeFixedToScreen(pSizeFixedToScreen.getValue(stub))
		
		return billboard
	end
	
	/**
	 * \brief Create billboard layer mask.
	 */
	func LayerMask createLayerMask(StubElement stub)
		var LayerMask layerMask = LayerMask.new(pLayerMask.getLayerMask(stub))
		if stub.getPropertyBoolFor(pRenderEnvMap.getName(), pRenderEnvMap.getValue())
			layerMask |= pLayerMaskRenderEnvMap.getLayerMask(stub)
		end
		return layerMask
	end
end
