namespace Dragengine.Scenery
pin Dragengine.StateMachineSystem
pin Dragengine.BehaviorTreeSystem
pin Dragengine.Utils
pin Dragengine.Preloading

/**
 * \brief GameWorld Behavior adding support for parameter tree.
 * \version 1.35
 * 
 * Loads parameter tree which elements can use to store configuration data in an organized way.
 * Parameter tree file is set using world property "parameterTree.path".
 * 
 * This behavior can be present only once in a GameWorld.
 */
class GWBehaviorParameterTree extends DefaultGWBehavior
	var ParameterTree pParameterTree
	
	
	/** \brief Create element. */
	func new(GameWorld gameWorld) super(gameWorld)
		pParameterTree = ParameterTree.new()
	end
	
	func void init(StubGameWorld stub)
		var String path = stub.getPropertyValueFor("parameterTree.path", null)
		if path == null or path.empty()
			return
		end
		
		BehaviorElementClass.sharedFactoryHelper.defaultLoaders().getParameterTree().loadFromFile(\
			/*File.absolutePath(path, getGameWorld().getPathGameWorld())*/ path, pParameterTree)
	end
	
	
	/** \brief Parameter tree. */
	func ParameterTree getParameterTree()
		return pParameterTree
	end
	
	
	/**
	 * \brief Get behavior in game world or null if absent.
	 * 
	 * Use this method to check if GameWorld contains behavior of type GWBehaviorParameterTree.
	 */
	static func GWBehaviorParameterTree getBehaviorIn(GameWorld gameWorld)
		return gameWorld.findBehavior(block GWBehaviorParameterTree each
			return true
		end) cast GWBehaviorParameterTree
	end
end
