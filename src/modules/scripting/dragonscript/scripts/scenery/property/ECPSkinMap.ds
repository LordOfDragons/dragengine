namespace Dragengine.Scenery
pin Dragengine.Gui
pin Dragengine.Preloading
pin Dragengine.Utils
pin Dragengine.LoadSave


/**
 * \brief Dictionary of skins element class property for use with XML loading.
 * \version 1.35
 * 
 * Similar to ECPSkin but assigns each skin a unique name. This is useful to define
 * a list of skins to use mapped against well known identifiers. Also allows to map
 * the same skin to multiple unique identifiers if required.
 */
class ECPSkinMap extends ElementClassProperty implements ResourceListener
	var Dictionary pPath, pSkins
	var Array pFailedLoading, pExceptions
	var PreloadCounter pCounter
	var bool pHasPreloaded
	
	
	/** \brief Create property. */
	func new(String name) super(name)
		pPath = Dictionary.new()
		pSkins = Dictionary.new()
	end
	
	func void dispose()
		pSkins = null
	end
	
	
	/** \brief Remove all path. */
	func void removeAllPath()
		pPath.removeAll()
	end
	
	/** \brief Set path to load for identifier. */
	func void setPathAt(String id, String path)
		pPath.setAt(id, path)
	end
	
	
	/** \brief Number of skins. */
	func int getCount()
		return pSkins.getCount()
	end
	
	/** \brief Skin with identifier or \em null if absent. */
	func Skin getAt(String id)
		return pSkins.getAt(id) cast Skin
	end
	
	/** \brief Visit skins with block with String id and Skin value. */
	func void forEach(Block ablock)
		pSkins.forEach(ablock)
	end
	
	/** \brief Remove all skins. */
	func void removeAll()
		pSkins.removeAll()
	end
	
	/** \brief Set skin for identifier. */
	func void setAt(String id, Skin skin)
		pSkins.setAt(id, skin)
	end
	
	/** \brief Property has been preloaded. */
	func bool getHasPreloaded()
		return pHasPreloaded
	end
	
	
	func void setValue(Object value)
		pPath.removeAll()
		(value cast Dictionary).forEach(block String id, String path
			pPath.setAt(id, path)
		end)
	end
	
	func void copyValue(ElementClass elementClass, ElementClassProperty property)
		var String basePath = elementClass.getBasePath()
		pPath = (property cast ECPSkinMap).pPath.map(block String id, String path
			return not path.empty() if File.absolutePath(path, basePath).getPath() else null
		end)
	end
	
	
	func void preloadResources(ElementClass elementClass, PreloadCounter counter)
		if pHasPreloaded
			return
		end
		
		pHasPreloaded = true
		pFailedLoading = null
		pExceptions = null
		pSkins.removeAll()
		pCounter = counter
		
		var String basePath = elementClass.getBasePath()
		pPath = pPath.map(block String id, String path
			pSkins.setAt(id, null)
			if not path.empty()
				path = File.absolutePath(path, basePath).getPath()
				Skin.loadAsynchron(path, this)
				counter.increase()
				return path
				
			else
				return ""
			end
		end)
	end
	
	func bool logPreloadProblems(ElementClass elementClass, Console console)
		if pFailedLoading == null
			return false
		end
		
		pFailedLoading.forEach(block int index, String each
			console.addError("Property {}.{}: Failed loading skin {}".format(\
				Array.newWith(elementClass.getClassname(), getName(), each)),\
				pExceptions.getAt(index) cast Exception)
		end)
		return true
	end
	
	
	/**
	 * \brief Skin map modified by stub property if present.
	 * 
	 * If named stub property is not present or empty string the stored skin map
	 * is returned. If the named stub property is present it is decoded using codec 
	 * 
	 * Supported element stub property values are:
	 * - "id1:path1 ... idN:pathN"
	 * 
	 * \returns Dictionary mapping String id to Skin.
	 */
	func Dictionary getSkins(StubWithProperties stub, CodecPropertyString codec)
		var String value = stub.getPropertyValueFor(getName(), "")
		if value.empty()
			return Dictionary.new(pSkins)
		end
		
		var Dictionary map = Dictionary.new()
		codec.decodeStringList(value).forEach(block String each
			var Array parts = each.splitExact(':')
			map.setAt(parts.getAt(0) cast String, Skin.new(parts.getAt(1) cast String))
		end)
		return map
	end
	
	
	func void finishedLoading(String path, ResourceLoaderType resourceType, Object resource)
		pPath.forEach(block String id, String path2
			if path.equals(path2)
				pSkins.setAt(id, resource)
			end
		end)
		pCounter.decrease()
	end
	
	func void failedLoading(String path, ResourceLoaderType resourceType)
		if pFailedLoading == null
			pFailedLoading = Array.new()
		end
		pFailedLoading.add(path)
		pCounter.decrease()
	end
end
