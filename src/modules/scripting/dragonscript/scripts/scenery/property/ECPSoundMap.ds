namespace Dragengine.Scenery
pin Dragengine.Gui
pin Dragengine.Preloading
pin Dragengine.Utils
pin Dragengine.LoadSave


/**
 * \brief Dictionary of sounds element class property for use with XML loading.
 * \version 1.35
 * 
 * Similar to ECPSound but assigns each sound a unique name. This is useful to define
 * a list of sounds to use mapped against well known identifiers. Also allows to map
 * the same sound to multiple unique identifiers if required.
 */
class ECPSoundMap extends ElementClassProperty implements ResourceListener
	var Dictionary pPath, pSounds
	var Array pFailedLoading, pExceptions
	var PreloadCounter pCounter
	var bool pHasPreloaded
	
	
	/** \brief Create property. */
	func new(String name) super(name)
		pPath = Dictionary.new()
		pSounds = Dictionary.new()
	end
	
	func void dispose()
		pSounds = null
	end
	
	
	/** \brief Remove all path. */
	func void removeAllPath()
		pPath.removeAll()
	end
	
	/** \brief Set path to load for identifier. */
	func void setPathAt(String id, String path)
		pPath.setAt(id, path)
	end
	
	
	/** \brief Number of sounds. */
	func int getCount()
		return pSounds.getCount()
	end
	
	/** \brief Sound with identifier or \em null if absent. */
	func Sound getAt(String id)
		return pSounds.getAt(id) cast Sound
	end
	
	/** \brief Visit sounds with block with String id and Sound value. */
	func void forEach(Block ablock)
		pSounds.forEach(ablock)
	end
	
	/** \brief Remove all sounds. */
	func void removeAll()
		pSounds.removeAll()
	end
	
	/** \brief Set sound for identifier. */
	func void setAt(String id, Sound sound)
		pSounds.setAt(id, sound)
	end
	
	/** \brief Property has been preloaded. */
	func bool getHasPreloaded()
		return pHasPreloaded
	end
	
	
	func void setValue(Object value)
		pPath.removeAll()
		(value cast Dictionary).forEach(block String id, String path
			pPath.setAt(id, path)
		end)
	end
	
	func void copyValue(ElementClass elementClass, ElementClassProperty property)
		var String basePath = elementClass.getBasePath()
		pPath = (property cast ECPSoundMap).pPath.map(block String id, String path
			return not path.empty() if File.absolutePath(path, basePath).getPath() else null
		end)
	end
	
	
	func void preloadResources(ElementClass elementClass, PreloadCounter counter)
		if pHasPreloaded
			return
		end
		
		pHasPreloaded = true
		pFailedLoading = null
		pExceptions = null
		pSounds.removeAll()
		pCounter = counter
		
		var String basePath = elementClass.getBasePath()
		pPath = pPath.map(block String id, String path
			pSounds.setAt(id, null)
			if not path.empty()
				path = File.absolutePath(path, basePath).getPath()
				Sound.loadAsynchron(path, this)
				counter.increase()
				return path
				
			else
				return ""
			end
		end)
	end
	
	func bool logPreloadProblems(ElementClass elementClass, Console console)
		if pFailedLoading == null
			return false
		end
		
		pFailedLoading.forEach(block int index, String each
			console.addError("Property {}.{}: Failed loading sound {}".format(\
				Array.newWith(elementClass.getClassname(), getName(), each)),\
				pExceptions.getAt(index) cast Exception)
		end)
		return true
	end
	
	
	/**
	 * \brief Sound map modified by stub property if present.
	 * 
	 * If named stub property is not present or empty string the stored sound map
	 * is returned. If the named stub property is present it is decoded using codec 
	 * 
	 * Supported element stub property values are:
	 * - "id1:path1 ... idN:pathN"
	 * 
	 * \returns Dictionary mapping String id to Sound.
	 */
	func Dictionary getSounds(StubWithProperties stub, CodecPropertyString codec)
		var String value = stub.getPropertyValueFor(getName(), "")
		if value.empty()
			return Dictionary.new(pSounds)
		end
		
		var Dictionary map = Dictionary.new()
		codec.decodeStringList(value).forEach(block String each
			var Array parts = each.splitExact(':')
			map.setAt(parts.getAt(0) cast String, Sound.new(parts.getAt(1) cast String))
		end)
		return map
	end
	
	
	func void finishedLoading(String path, ResourceLoaderType resourceType, Object resource)
		pPath.forEach(block String id, String path2
			if path.equals(path2)
				pSounds.setAt(id, resource)
			end
		end)
		pCounter.decrease()
	end
	
	func void failedLoading(String path, ResourceLoaderType resourceType)
		if pFailedLoading == null
			pFailedLoading = Array.new()
		end
		pFailedLoading.add(path)
		pCounter.decrease()
	end
end
